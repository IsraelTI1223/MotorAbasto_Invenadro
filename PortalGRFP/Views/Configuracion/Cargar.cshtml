@{
    List<PortalGRFP.Entities.Models.DatLayouts.LayoutBase> TableError = ViewBag.TableError;
    bool PuedeCargar = ViewBag.PuedeCargar;
    ViewBag.Title = $"{DateTime.Now.ToString("dd/MM/yyyy")} Archivos cargados";
}
@model List<PortalGRFP.Entities.Common.DescuentoHdr>
@Html.Hidden("hFlagPuedeCargar", PuedeCargar)

@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>CARGA ARCHIVOS</a></li>
    <li class="breadcrumb-item active"><a>CARGAS PMP</a></li>
}

@section Actions{
    <button style="display:none;" class="btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" id="btnUploadFileModal" data-toggle="modal" data-target="#uploadFileModal">
        <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-cloud-upload" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M4.406 1.342A5.53 5.53 0 0 1 8 0c2.69 0 4.923 2 5.166 4.579C14.758 4.804 16 6.137 16 7.773 16 9.569 14.502 11 12.687 11H10a.5.5 0 0 1 0-1h2.688C13.979 10 15 8.988 15 7.773c0-1.216-1.02-2.228-2.313-2.228h-.5v-.5C12.188 2.825 10.328 1 8 1a4.53 4.53 0 0 0-2.941 1.1c-.757.652-1.153 1.438-1.153 2.055v.448l-.445.049C2.064 4.805 1 5.952 1 7.318 1 8.785 2.23 10 3.781 10H6a.5.5 0 0 1 0 1H3.781C1.708 11 0 9.366 0 7.318c0-1.763 1.266-3.223 2.942-3.593.143-.863.698-1.723 1.464-2.383z" />
            <path fill-rule="evenodd" d="M7.646 4.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 5.707V14.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708l3-3z" />
        </svg> Subir archivo
    </button>
}

@if (Model != null)
{
    <div class="col-lg-12">
        <div class="table-responsive">
            <table class="table table-striped mg-b-0" id="tb-history">
                <thead class="thead-primary">
                    <tr>
                        <th>Tipo de carga</th>
                        <th>Nombre del archivo</th>
                        <th>Usuario</th>
                        <th>Fecha</th>
                        <th>Cargados</th>
                        <th>Errores</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.TipoCarga</td>
                            <td>@item.NombreArchivo</td>
                            <td>@item.UsuarioRegistro</td>
                            <td>@item.FechaRegistro</td>
                            <td>@item.TotalCargados</td>
                            <td>@item.TotalErroneos</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div><!-- table-responsive -->
    </div>
}

<!--#region [Resultado]-->
<br /><br />
<div class="col-lg-12" id="panelResult" style="display:none;">
    <br />
    <div class="row row-xs">
        <!--#region [Indicadores]-->
        <div class="col-sm-6 col-lg-4">
            <div class="card card-body">
                <h6 class="tx-uppercase tx-11 tx-spacing-1 tx-color-02 tx-semibold mg-b-8">Total de registros validos</h6>
                <div class="d-flex d-lg-block d-xl-flex align-items-end">
                    <h3 class="tx-normal tx-rubik mg-b-0 mg-r-5 lh-1" id="RowsOKResult">0</h3>
                    <p class="tx-11 tx-color-03 mg-b-0"><span class="tx-medium tx-success">OK<i class="icon ion-md-arrow-up"></i></span> de un total de <span id="okSpanTot">0</span> registros procesados</p>
                </div>
                <div class="chart-three">
                    <div id="flotChart3" class="flot-chart ht-30"></div>
                </div><!-- chart-three -->
            </div>
        </div><!-- col -->
        <div class="col-sm-6 col-lg-4 mg-t-10 mg-sm-t-0">
            <div class="card card-body">
                <h6 class="tx-uppercase tx-11 tx-spacing-1 tx-color-02 tx-semibold mg-b-8">Total de registros con Error</h6>
                <div class="d-flex d-lg-block d-xl-flex align-items-end">
                    <h3 class="tx-normal tx-rubik mg-b-0 mg-r-5 lh-1" id="RowsErrorResult">0</h3>
                    <p class="tx-11 tx-color-03 mg-b-0"><span class="tx-medium tx-danger">ERROR <i class="icon ion-md-arrow-down"></i></span> de un total de <span id="errorSpanTot">0</span> registros procesados</p>
                </div>
                <div class="chart-three">
                    <div id="flotChart4" class="flot-chart ht-30"></div>
                </div><!-- chart-three -->
            </div>
        </div><!-- col -->
        <div class="col-sm-6 col-lg-4 mg-t-10 mg-lg-t-0">
            <div class="card card-body">
                <h6 class="tx-uppercase tx-11 tx-spacing-1 tx-color-02 tx-semibold mg-b-8">Tiempo de procesamiento</h6>
                <div class="d-flex d-lg-block d-xl-flex align-items-end">
                    <h3 class="tx-normal tx-rubik mg-b-0 mg-r-5 lh-1" id="TimeProcess">0</h3>
                    <p class="tx-11 tx-color-03 mg-b-0"> milisegundos de lectura</p>
                    <h3 class="tx-normal tx-rubik mg-b-0 mg-r-5 lh-1" id="TimeLoadProcess">0</h3>
                    <p class="tx-11 tx-color-03 mg-b-0"> segundos de escritura en DB</p>
                </div>
                <div class="chart-three">
                    <div id="flotChart5" class="flot-chart ht-30"></div>
                </div><!-- chart-three -->
            </div>
        </div><!-- col -->
        <!--#endregion-->
        <!--#region [Tabla de resultados]-->
        <div class="col-lg-12 col-xl-12 mg-t-10">
            <div class="card mg-b-12">
                <div class="card-header pd-t-20 d-sm-flex align-items-start justify-content-between bd-b-0 pd-b-0">
                    <div>
                        <h6 class="mg-b-5" id="FileResult"></h6>
                        <p class="tx-13 tx-color-03 mg-b-0" id="TotalRows"></p>
                    </div>
                </div><!-- card-header -->
                <div class="card-body pd-y-30">
                    <h4 class="mg-b-0 tx-spacing--1">Detalle de Errores</h4>
                    <br />
                    <div class="table-responsive">
                        <table class="table table-striped mg-b-0" id="tb-result">
                            <thead class="thead-primary">
                                <tr>
                                    <th>Fila</th>
                                    <th>Código EAN</th>
                                    <th>Mensaje</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div><!-- table-responsive -->
                </div><!-- card-body -->
            </div><!-- card -->
        </div><!-- col -->
        <!--#endregion-->
    </div><!-- row -->
</div>
<!--#endregion-->
<!--#region [Modal]-->
<div class="modal fade" id="uploadFileModal" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">Subir Layout PMP</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="custom-file">
                    <input type="file" class="custom-file-input" id="fileLDCOM">
                    <label id="lblFileName" class="custom-file-label" for="customFile">Seleccionar archivo</label>
                    <div id="feedback" class="invalid-feedback">Es necesario seleccionar un archivo</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnBulkLoadDiscount">Guardar</button>
            </div>
        </div>
    </div>
</div>
<!--#endregion-->

@section scripts{
    <script src="~/Scripts/App/Common/numeral.min.js" type="text/javascript"></script>
    <script type="text/javascript" src="~/Scripts/App/Views/configuracionCargarPMP.js"></script>
}
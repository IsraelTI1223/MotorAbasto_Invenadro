@model PortalGRFP.Entities.Common.SugeridoFiltros
@using PortalGRFP.Entities.Common

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>Reportes</a></li>
    <li class="breadcrumb-item"><a>Consulta Invenadro Cargado</a></li>
}

<form id="frmInvenadro" method="post">
    <div class="row">
        <div class="col-md-2">
            Cadena:
            <select id="Grupo" name="Grupo" multiple="multiple" class="form-control col-md-10">
                @foreach (var item in TempData["Cadena"] as List<Combo4>)
                {
                    <option value="@item.Filtro">@item.Filtro</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            Sucursales:
            <select id="Sucursal" name="Sucursal" multiple="multiple" class="form-control col-md-10" disabled>
                <option value="0">Seleccione una Sucursal</option>
            </select>
        </div>

        <div class="col-md-2">
            Estatus Producto:
            <select id="Estatus" name="Estatus" multiple="multiple" class="form-control col-md-10">
                @foreach (var item in TempData["Estatus"] as List<Combo4>)
                {
                    <option value="@item.Filtro">@item.Filtro</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            Seleccionar SKU:
            <select id="SKU" name="SKU" multiple="multiple" class="form-control" disabled>
                <option value="0">Seleccione un SKU</option>
            </select>
        </div>
        <div class="col-md-2">
            Invenadro:
            <select id="Conceptos" name="Conceptos" multiple="multiple" class="form-control">
                <option value="0">Cero</option>
                <option value="1">Mayor a Cero</option>
            </select>
        </div>
        <br />
        <br />
        <br />
        <div class="col-md-2">
            <input type="submit" value="Buscar" class="btn btn-primary" />
        </div>
    </div>
</form>

<div class="container-fluid">
    <div class="card">
        <div class="card-body" id="contenedor_tb2">
            <h5>Rechazos Sucursales sin Cuenta</h5><br />
            <row>
                <table id="DTArticulos" class="display compact cell-border" width="100%"></table>
            </row>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $("#contenedor_tb2").hide();

        $(document).ready(function () {
            'use strict';

            $('#Grupo').multiselect({
                nonSelectedText: 'Seleccione una Cadena',
                enableFiltering: true,
                includeSelectAllOption: true,
                maxHeight: 400,
                buttonWidth: '150px',
                buttonTextAlignment: 'left',
                selectAllText: "Marcar Todos",
                allSelectedText: "Todos Seleccionados",
                nSelectedText: "Cadenas Seleccionadas"
            });

            $('#Sucursal').multiselect({
                nonSelectedText: 'Seleccione una Sucursal',
                enableFiltering: true,
                includeSelectAllOption: true,
                maxHeight: 400,
                buttonWidth: '150px',
                //dropUp: true,
                selectAllText: "Marcar Todas",
                allSelectedText: "Todas Seleccionadas",
                nSelectedText: "Sucursales Seleccionados"
            });

            $('#Estatus').multiselect({
                nonSelectedText: 'Seleccione un Estatus',
                enableFiltering: true,
                includeSelectAllOption: true,
                maxHeight: 400,
                buttonWidth: '150px',
                //dropUp: true,
                selectAllText: "Marcar Todos",
                allSelectedText: "Todos Seleccionados",
                nSelectedText: "Estatus Seleccionados"
            });

            $('#SKU').multiselect({
                nonSelectedText: 'Seleccione un SKU',
                enableFiltering: true,
                includeSelectAllOption: true,
                maxHeight: 400,
                buttonWidth: '150px',
                //dropUp: true,
                selectAllText: "Marcar Todos",
                allSelectedText: "Todos Seleccionados",
                nSelectedText: "SKU Seleccionados"
            });

            $('#Conceptos').multiselect({
                nonSelectedText: 'Seleccione un concepto',
                enableFiltering: true,
                includeSelectAllOption: true,
                maxHeight: 400,
                buttonWidth: '150px',
                //dropUp: true,
                selectAllText: "Marcar Todos",
                allSelectedText: "Todos Seleccionados",
                nSelectedText: "Conceptos Seleccionados"
            });

            $("#Grupo").on("change", function () {
                var datos = new FormData();
                datos.append("idGrupo", $(this).val());
                GetFarmacias(datos);
            });

            function GetFarmacias(datos) {
                showLoading();
                $('#Sucursal').empty();
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetSucursal", "ConsultaInvenadro")",
                    data: datos,
                    dataType: "json",
                    processData: false,  // tell jQuery not to process the data
                    contentType: false,
                    success: function (response) {
                        hideLoading();
                        var sucursales = '';
                        for (var i = 0; i < response.length; i++) {
                            sucursales = sucursales + '<option value=' + response[i].Id + '>' + response[i].Valor + '</option>';
                        }

                        $('#Sucursal').append(sucursales);
                        $('#Sucursal').multiselect('rebuild');
                        document.getElementById("Sucursal").disabled = false;
                    },
                    error: function (response) {
                    }
                });
            }


            $("#Estatus").on("change", function () {
                var datos = new FormData();
                datos.append("idEstatus", $(this).val());
                console.log($(this).val())
                GetSKU(datos);
            });

            function GetSKU(datos) {
                showLoading();
                $('#SKU').empty();
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetSKU", "ConsultaInvenadro")",
                    data: datos,
                    dataType: "json",
                    processData: false,  // tell jQuery not to process the data
                    contentType: false,
                    success: function (response) {
                        hideLoading();
                        var sku = '';
                        for (var i = 0; i < response.length; i++) {
                            sku = sku + '<option value=' + response[i].Id + '>' + response[i].Valor + '</option>';
                        }

                        $('#SKU').append(sku);
                        $('#SKU').multiselect('rebuild');
                        document.getElementById("SKU").disabled = false;
                    },
                    error: function (response) {
                    }
                });
            }


            $("#frmInvenadro").on("submit", function (event) {
                event.preventDefault();
                showLoading();
                var form = $("#frmInvenadro").serializeArray()
                    .filter(function (elem) {
                        return $.trim(elem.value);
                    });

                if ($("#SKU").val() == null || $("#Sucursal").val() == null || $("#Grupo").val() == null || $("#Conceptos").val() == null) {
                    alert("Seleccionar Todos los filtros");
                    return;
                }
                getDTCuenta(form) 
                });
        });

            function getDTCuenta(form) {
                showLoading();
                $.ajax({
                    url:  "/ConsultaInvenadro/ConsultarProductoInvenadro",
                    type: "POST",
                    dataType: "json",
                    data: form,
                    success: function (data) {
                        $("#contenedor_tb2").show();
                        hideLoading();

                        console.log(data)

                        hideLoading();

                        $('#DTArticulos').DataTable({
                            data: data,
                            "destroy": true,
                            "processing": true,
                            dom: 'Bfrtip',
                            columns: [
                                { data: "Sucursal", title: 'Sucursal' },
                                { data: "SKU", title: 'SKU' },
                                { data: "Descripcion", title: 'Descripcion' },
                                { data: "Grupo", title: 'Grupo' },
                                { data: "Familia", title: 'Familia' },
                                { data: "Existencia", title: 'Existencia' },
                                { data: "Invenadro", title: 'Invenadro' }
                            ],
                            select: true,
                            scrollCollapse: true,
                            info: false,
                            paging: true,
                            responsive: true,
                            searching: true
                        });
                    },
                    error: function (response) {
                        hideLoading();
                    }
                });
            }
                //table.draw();
          

        

    </script>
}
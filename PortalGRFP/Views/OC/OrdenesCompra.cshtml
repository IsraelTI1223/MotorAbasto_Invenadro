                                } else {
                                    swal("Error al Enviar Ordenes de compra", data.Message, "error");
                                }
                               getOrdenesCompra();

                            },
                            error: function (response) {
                                hideLoading();
                                swal("Error inesperado al Eliminar OC", '', "error: " + response);
                            }
                        });

                    }
                }
            });
        }






    </script>
    
}
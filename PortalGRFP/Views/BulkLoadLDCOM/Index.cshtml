
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-8">
        <div class="custom-file">
            <input type="file" class="custom-file-input" id="fileLDCOM" accept=".xlsx">
            <label class="custom-file-label" for="customFile">Seleccionar archivo</label>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="btn-group">
            <button type="button" class="btn btn-success" title="Subir archivo" id="btnBulkLoadLDCOM">
                <i data-feather="arrow-up"></i>&nbsp;Subir archivo
            </button>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript" src="~/Scripts/App/Views/bulkLoadLdcom.js"></script>
}
@using PortalGRFP.Entities.Common

@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>CONSULTA</a></li>
    <li class="breadcrumb-item active"><a>REPORTES</a></li>
    <li class="breadcrumb-item"><a>CONSULTA ARTICULO SUCURSAL</a></li>
}
<div class="card" style="width:100%">
    <div class="card-header">
        <div class="row" style="margin-top:1%">
            <div class="col-auto">
                <label for="cbGrupos">Seleccionar Grupos:</label><br />
                <select class="form-control" id="cbGrupos" min="1" multiple required>
                    <!--<option value="0">Seleccione Grupo</option>-->
                    @foreach (var item in TempData["gruposArticuloSuc"] as List<ComboGenerico>)
                    {
                        <option value="@item.Id">@item.Valor</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label for="cbTiendas">Seleccionar Sucursal:</label><br />
                <select class="form-control" id="cbTiendas" multiple required>
                    <option disabled selected>Seleccione Sucursal:</option>
                </select>
            </div>
            <div class="col-auto">
                <label for="cbStatus">Seleccionar Estatus:</label><br />
                <select class="form-control" id="cbStatus" min="1" required>
                    <option disabled selected>Estatus Producto</option>
                    @*<option>Vigente</option>
                        <option>Descontinuado</option>*@
                    <option>Activo</option>
                    <option>Inactivo</option>
                    <option>Todos</option>
                </select>
            </div>
            <div class="col-auto" style="margin-top:2.3%">
                <button type="submit" class="btn btn-sm pd-x-15 btn-primary btn-lg" id="btnBuscar" onclick="getArticulosList()">
                    <i class="fa fa-search" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>
</div>
<table id="DTArticulos" class="display compact cell-border" width="100%"></table>

@section scripts{


    <script>
        $('#cbGrupos').multiselect({
            nonSelectedText: 'Lista de Grupos',
            enableFiltering: true,
            includeSelectAllOption: true,
            maxHeight: 400,
            buttonWidth: '150px',
            buttonTextAlignment: 'left',
            selectAllText: "Marcar Todos",
            allSelectedText: "Todas Seleccionados",
            nSelectedText: "Grupos"
        });
        $('#cbTiendas').multiselect({
            nonSelectedText: 'Lista de Sucursales',
            enableFiltering: true,
            includeSelectAllOption: true,
            maxHeight: 400,
            buttonWidth: '150px',
            buttonTextAlignment: 'left',
            selectAllText: "Marcar Todas",
            allSelectedText: "Todas Seleccionados",
            nSelectedText: "Sucursales"
        });
         $("#cbGrupos").on("change", function () {

             if ($("#cbGrupos").val() == '') {
                 $("#cbTiendas").html("");
                 $("#cbTiendas").append('<option disabled selected>Seleccione Sucursal:</option>');
                 return;
             }
                getSucursalesCadenas($("#cbGrupos").val());
         });

        $("#cbTiendas").on("change", function () {

            console.log($("#cbTiendas").val())
        });



            function getSucursalesCadenas(data) {

                console.log(data)
                showLoading();
                $('#cbTiendas').empty();
                $.ajax({
                     url: "@Url.Action("GetSucursalesXGrupo", "ConsultaArticulosSucursal")",
                    type: "POST",
                    dataType: "json",
                    data: { search: String(data) },
                    success: function (response) {
                        hideLoading();
                        var sucursales = "";

                        console.log(response)

                        if (response.data != null) {

                            for (var i = 0; i < response.data.length; i++) {
                                sucursales = sucursales + '<option value=' + response.data[i].Id + '>' + response.data[i].Valor + '</option>';
                            }
                            sucursales = sucursales;// + '<option disabled selected>Seleccione Sucursal:</option>'
                        }

                        $("#cbTiendas").append(sucursales);

                        $('#cbTiendas').multiselect('rebuild');
                    },
                    error: function (response) {
                        hideLoading();
                    }
                });

        }
        var table = $('#DTArticulos').DataTable({

            "destroy": true,
            "processing": true,
            dom: 'Bfrtip',
            columns: [
                { title: 'Sucursal' },
                { title: 'SKU' },
                { title: 'Descripción' },
                { title: 'Grupo' },
                { title: 'Familia' },
                { title: 'Estatus' },
                { title: 'Existencia' },
                { title: 'Transito' },
                { title: 'PVD' },
                { title: 'Invenadro' },
                { title: 'Capacity' },
                { title: 'Motivo' },
                { title: 'Tipo de Proveedor' },
                { title: 'RotABC' },
                { title: 'Politica Dias' },
                { title: 'Fecha Activo' },
                { title: 'Fecha Inactivo' },
                { title: 'Venta30Dias' }


            ],
            select: true,
            scrollCollapse: true,
            info: false,
            paging: true,
            responsive: true,
            searching: true
        });

        function getArticulosList() {



           // console.log('tabla:'+table)

            ////clear datatable
            //table.clear().draw();

            ////destroy datatable
            //table.destroy();
            if ($("#cbTiendas").val() == null || $("#cbStatus").val() == null) {
                alert("Seleccionar Todos los filtros");
                return;
            }
            showLoading();

            table.clear();
            //table.fnDraw();
            //dataTable.fnDestroy();



                $.ajax({
                    url: "@Url.Action("ConsultarProductosXSuc", "ConsultaArticulosSucursal")",
                    type: "POST",
                    dataType: "json",
                    data: { storeId: String($("#cbTiendas").val()), estatus: String($("#cbStatus").val()) },
                    success: function (data) {
                        //console.log(data)
                        hideLoading();

                        $('#DTArticulos').DataTable({
                            data: data,
                            "destroy": true,
                            "processing": true,
                            dom: 'Bfrtip',
                            columns: [
                                { data: "ID_Sucursal", title: 'Sucursal' },
                                { data: "SKU", title: 'SKU' },
                                { data: "DESCRIPCION_CORTA", title: 'Descripción' },
                                { data: "GRUPO", title: 'Grupo' },
                                { data: "FAMILIA", title: 'Familia' },
                                { data: "Estatus", title: 'Estatus' },
                                { data: "Existencia", title: 'Existencia' },
                                { data: "Transito", title: 'Transito' },
                                { data: "PVD", title: 'PVD' },
                                { data: "Invenadro", title: 'Invenadro' },
                                { data: "Capacity", title: 'Capacity'},
                                { data: "Motivo", title: 'Motivo' },
                                { data: "TipoProveedor", title: 'Tipo de Proveedor' },
                                { data: "RotABC", title: 'RotABC' },
                                { data: "PoliticaDias", title: 'Politica Dias' },
                                { data: "FechaActivo", title: 'Fecha Activo' },
                                { data: "FechaInactivo", title: 'Fecha Inactivo' },
                                { data: "piezas_total", title: 'Venta30Dias' }


                            ],
                            select: true,
                            scrollCollapse: true,
                            info: false,
                            paging: true,
                            responsive: true,
                            searching: true
                        });





                    },
                    error: function (response) {
                        hideLoading();
                    }
                });
            table.draw();

            }





    </script>
}




@using PortalGRFP.Entities.Common
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>Configuraciones</a></li>
    <li class="breadcrumb-item"><a>Generales</a></li>
    <li class="breadcrumb-item"><a>Invenadro</a></li>
}
<div class="container">
    <div class="btn-group" role="group" aria-label="Basic example">
        <a href='@Url.Action("Index", "ConfiguracionInvenadro")' class="btn btn-secondary">Invenadro General</a>
        <a href='@Url.Action("Exclusiones", "ConfiguracionInvenadro")' id="btnPestañaExcluidos" class="btn btn-secondary active">Excluidos</a>
        <a href='@Url.Action("ResumenInvenadro", "ConfiguracionInvenadro")' id="btnResumen" class="btn btn-secondary">Resumen Invenadro</a>
        <a href='@Url.Action("BalanceoCDRs", "ConfiguracionInvenadro")' id="btnPestañaCDR " class="btn btn-secondary">Balanceo</a>
    </div>

    <div class="card" style="width:100%">

        <div class="container-fluid">
            <br />
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="label-primary">SKU: </label>
                        <input type="text" id="txtSKU" class="form-control" maxlength="30" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="label-primary">Sucursal: <span style="color:gray"></span></label>
                        <select class="form-control" id="cmbSucursal" name="cmbSucursal" data-mdb-filter="true" multiple>
                            @if (TempData["Sucursal"] != null)
                            {
                                foreach (var item in TempData["Sucursal"] as List<ComboGenerico>)
                                {
                                    <option value="@item.Id"> @item.Valor</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-sm pd-x-15 btn-secondary mg-l-6" type="button" id="btnConsulta" onclick="GetExcludos();">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
                <div class="col-md-3">
                </div>
                <div class="col-auto">
                    <button title="Exportar Excel" class="btn btn-success" id="btnExportarExcel"
                            style="margin-top: 25px;">
                        Exportar Excel
                    </button>
                </div>
            </div>


        </div>
        
        <br>
    </div>

    <div class="card" style="width:100%">
        <div class="row">
            <div class="col-md-12">
                <div class="card-body" id="fullTbl2">
                    <div class="table-responsive">
                        <table id="tblExcluidos" class="table table-striped table-bordered">
                        </table>

                    </div>
                    
                </div>
            </div>
            
        </div>
    </div>


</div>

<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/select/1.7.0/js/dataTables.select.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap4.min.js"></script>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap4.min.css">



<script>

    $(document).ready(function () {

        $('#cmbSucursal').multiselect({
            nonSelectedText: 'Lista de Sucursales',
            enableFiltering: true,
            includeSelectAllOption: true,
            maxHeight: 400,
            buttonWidth: '250px',
            buttonTextAlignment: 'left',
            selectAllText: "Marcar Todas",
            nSelectedText: "Farmacias Seleccionadas",
            allSelectedText: "Todas Seleccionadas",
            enableCaseInsensitiveFiltering: true,
            nSelectedText: "Sucursales Seleccionadas"
        });

        $("#btnExportarExcel").hide();

    });

    $("#btnExportarExcel").on("click", function () {
       var sku = $("#txtSKU").val().trim();
       var sucursales = $("#cmbSucursal").val();
       var sucursalesCSV = "";

       if (sucursales != null && sucursales.length > 0) {
        sucursalesCSV = sucursales.join(",");
       }

        var url = "@Url.Action("DescargarExcelExcluidos", "ConfiguracionInvenadro")"
        + "?SKU=" + encodeURIComponent(sku)
        + "&Sucursales=" + encodeURIComponent(sucursalesCSV);

        window.location.href = url;
    });

    function GetExcludos() {
        showLoading();
        var sku = $("#txtSKU").val().trim();
        var sucursales = $("#cmbSucursal").val();
        var sucursalesCSV = "";

        if (sucursales != null && sucursales.length > 0) {
            sucursalesCSV = sucursales.join(",");
        }
        $.ajax({
          url: "@Url.Action("GetProdExcluidos", "ConfiguracionInvenadro")",
          type: "GET",
          dataType: "json",
          data: {
            SKU: sku,
            Sucursales: sucursalesCSV
          },
          success: function (response) {
              hideLoading();
              if (response.Success) {
                  $("#btnExportarExcel").show();
                  $("#cardAutorizacion").show();
                  $('#tblExcluidos').DataTable({
                      data: response.Result,
                      destroy: true,
                      processing: true,
                      deferRender: true,
                      pageLength: 10,
                      scrollCollapse: true,
                      searching: true,
                      ordering: true,
                      dom: 'Bfrtip',
                      columns: [
                          { data: "IdSucursal", title: "Id" , visible: false},
                          { data: "NombreSucursal", title: "Sucursal" },
                          { data: "SKU", title: "SKU" },
                          { data: "NombreSKU", title: "Descripción", visible: false },
                          { data: "OptimoAnterior", title: "Óptimo Actual" },
                          { data: "OptimoActualizado", title: "Óptimo Nuevo" },
                          { data: "PVD", title: "PVD" },
                          { data: "RelacionInvenadroVenta", title: "Relación Invenadro" },
                          { data: "Motivo", title: "Motivo" }
                      ]
                  });
              } else {
                  swal("Sin resultados", "", "warning");
              }
          },
          error: function () {
              hideLoading();
              swal("Error al consultar excluidos", "", "error");
          }
        });

    }


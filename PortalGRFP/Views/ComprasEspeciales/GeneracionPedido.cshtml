        function getDateNow() {

            var f = new Date();
            var mes;
            var year;
            var dia;


            if ((f.getMonth() + 1) < 10) {
                mes = "0" + (f.getMonth() + 1)
            } else {
                mes = (f.getMonth() + 1)

            }

            if (f.getDate() < 10) {
                dia = "0" + f.getDate();

            } else {
                dia = f.getDate();
            }

            var diaMax = 0;


            if ((f.getDate()+3) < 10) {
                diaMax = "0" + (f.getDate()+3);

            } else {
                diaMax = (f.getDate()+3);
            }


            year = f.getFullYear();




           // console.log(year + "-" + mes + "-" + dia + "T00:00:00")

            //var diaMax = dia + 3;
            console.log(diaMax)

            document.getElementById("txtGenOC").min = year + "-" + mes + "-" + dia;
            document.getElementById("txtGenOC").max = year + "-" + mes + "-" + diaMax;



        }



@using PortalGRFP.Entities.Common.ComprasEspeciales

@{
    ViewBag.Title = "Consulta de Pedidos";
}

@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>Compras Especiales</a></li>
    <li class="breadcrumb-item"><a>Consulta de Pedidos</a></li>
}

<div class="card" style="width:100%">
    <div class="card-header">
        <div class="row" style="margin-top:1%">
            <div class="col-auto">
                <label for="cbGrupos">Seleccionar Grupos:</label><br />
                <select class="form-control" id="cbGrupos" min="1" multiple required>
                    <!--<option value="0">Seleccione Grupo</option>-->
                    @foreach (var item in TempData["listGrupos"] as List<ConsultaPedidosModel.GruposListViewsModel>)
                    {
                        <option value="@item.ID">@item.Valor</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label for="cbTiendas">Seleccionar Sucursales:</label><br />
                <select class="form-control" id="cbTiendas" min="1" multiple required>
                </select>
            </div>
            <div class="col-auto" style="margin-top:2.3%">
                <button type="submit" class="btn btn-sm pd-x-15 btn-warning btn-lg" id="btnBuscar" onclick="getPedidos()">
                    <i class="fa fa-search" aria-hidden="true"></i>
                </button>
            </div>
            <div class="col-auto" style="margin-top:2.3%">
                <button title="Nuevo Pedido" class="btn btn-sm pd-x-15 btn-success btn-lg" onclick="document.location.href='@Url.Content("~/ComprasEspeciales/GeneracionPedido/")'">
                    <i class="fa fa-plus-circle" aria-hidden="true"></i>
                </button>
            </div>
            <div class="col-auto" style="margin-top:2.3%">
                <button style="display: none" title="Eliminar Pedido Marcado" class="btn btn-sm pd-x-15 btn-danger btn-lg" id="btnEliminar">
                    <i class="fa fa-trash" aria-hidden="true"></i>
                </button>
            </div>
            <div class="col-auto" style="margin-top:2.3%">
                <button style="display: none" class="btn btn-sm pd-x-15 btn-primary btn-lg" id="btnEnviarSugerido" onclick="enviarSugerido()" title="Enviar a Sugerido">
                    <i class="fa fa-paper-plane" aria-hidden="true"></i>
                </button>
                
            </div>

            </div>
        </div>
    <div class="card-body">
        <table id="tbPedidos" class="display compact cell-border" width="100%"></table>
    </div>

</div>


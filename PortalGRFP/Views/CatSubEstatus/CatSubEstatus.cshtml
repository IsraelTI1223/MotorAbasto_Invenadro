@model List<PortalGRFP.Entities.Common.CatSubEstatusModel>



@{
    ViewBag.Title = "Catálogo de SubEstatus Permiso de Compra/Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<span class="anchor" id="formComplex"></span>
@section Breadcrumbs{
    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Home</a></li>
    <li class="breadcrumb-item"><a>Mantenimiento</a></li>
    <li class="breadcrumb-item"><a>Permiso de Compra/Venta </a></li>
    <li class="breadcrumb-item"><a>Catálogo de SubEstatus</a></li>

}



<div class="col-sm-12">
    <div class="row">
        <div class="col-12">
            <label for="groupBtn"><strong>Catálogo de SubEstatus</strong></label>
        </div>
        <div class="col-auto" style="display: none" id="btnCleanInputs">
            <button title="Nuevo Tipo de Pedido" class="btn btn-sm pd-x-15 btn-success btn-lg" onclick="cleanInputs()">
                <i class="fa fa-plus-circle" aria-hidden="true"></i>
            </button>
        </div>
    </div>
    <div class="card mb-12" style="height:8.7rem">

        <form id="frm">
            <div class="card-body">
                <div class="row g-0">
                    <div class="col-md-2 pb-1">
                        <label for="idInput" class="visually-hidden">Id</label>
                        <input readonly type="number" value="0" class="form-control" id="idInput" placeholder="0">
                    </div>
                    <div class="col-md-4 pb-1">
                        <label for="nombreInput" class="visually-hidden">Nombre SubEstatus</label>
                        <input type="text" class="form-control" id="nombreInput" placeholder="Nombre del SubEstatus" pattern="[A-Za-z0-9 áéíóúÁÉÍÓÚ]+" maxlength="45">
                    </div>
                </div>
                <div style="text-align:right">
                    <button id="btnContinuar" type="submit" class="btn btn-success mb-3">Continuar</button>
                </div>

            </div>
        </form>
    </div>
</div>

<div class="col-sm-12" style="margin-top: 1%">
    <div class="row">
        <div class="table-responsive">
            <table class="table table-striped" id="DTSubEst">
                <thead class="thead-primary">
                    <tr>
                        <th style="width:10%">#Id</th>
                        <th style="width:80%">Nombre</th>
                        <th style="width:10%"></th>
                    </tr>
                </thead>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nombre</td>
                        <td>
                            <button onclick="deletePedido(@item.Id)" class="btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" title="Borrar Proveedor">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                    <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4L4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" />
                                </svg>
                            </button>

                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>


@section scripts{
    <script>
        function cleanInputs() {

            $("#btnCleanInputs").hide();
            $("#idInput").val('0');
            $("#nombreInput").val('');

        }

        function deletePedido(Id) {

            console.log(Id)

            if (confirm("Vas a eliminar información, ¿Seguro de continuar?")) {


                var formData = new FormData();

                formData.append("Id", Id);

                showLoading();
                $.ajax({
                    type: "POST",
                    url: "/CatSubEstatus/EliminarSubEstatus",
                    processData: false,
                    contentType: false,
                    data: formData,
                    success: function (response) {
                        hideLoading();
                        if (response == "ok") {

                            swal("SubEstatus eliminado correctamente", '', "success").then((value) => {
                                window.location.reload();

                            });
                        } else {
                            swal("Error al modificar", '', "error");
                        }
                    },
                    error: function (e) {
                        hideLoading();
                        swal("¡Error inesperado en el proceso!", '', "error");
                    }
                });
            }
        }

        $(document).ready(function () {

            $(function () {
                'use strict'

                $('#DTSubEst').dataTable({
                    language: {
                        url: 'https://cdn.datatables.net/plug-ins/1.10.15/i18n/Spanish.json',
                        searchPlaceholder: "Buscar",
                        sSearch: '',
                        lengthMenu: '_MENU_ filas / paginas'
                    }
                });
            });

            $("#frm").submit(function (e) {
                e.preventDefault();

                if ($("#nombreInput").val() != "") {

                    if (confirm("Vas guardar información, ¿Seguro de continuar?")) {


                        showLoading();

                        var formData = new FormData();
                        formData.append("Nombre", $("#nombreInput").val());
                        formData.append("Id", $("#idInput").val());
                        formData.append("Estatus", 1);

                        $.ajax({
                            url: "/CatSubEstatus/CrearSubEstatus",
                            type: 'POST',
                            cache: false,
                            contentType: false,
                            processData: false,
                            data: formData,

                            success: function (response) {
                                hideLoading();

                                if (response.Success) {

                                    swal(response.Message, '', "success").then((value) => {
                                        window.location.reload();

                                    });
                                } else {
                                    swal(response.Message, '', "error");
                                }
                            },
                            error: function (e) {
                                hideLoading();
                                swal(response.Message, '', "error");
                            }
                        });
                    }
                } else {
                    swal("El campo Nombre es obligatorio", '', "error");
                }


            });


            $("#DTSubEst tbody").on('click', 'tr', function () {

                $("#btnCleanInputs").show();

                var rowData = $(this).children("td").map(function () {
                    return $(this).text();
                }).get();

                $("#idInput").val(rowData[0]);
                $("#nombreInput").val(rowData[1]);

            });

        })
    </script>
}



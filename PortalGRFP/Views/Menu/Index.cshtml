@helper SubMenus(List<SubModuloModel> subMenus)
{
    if (subMenus != null)
    {
        <ul class="dropdown-menu">
            @foreach (var subMenu in subMenus)
            {
                <li><a tabindex="-1" href="#"><i class="@subMenu.IconoBase text-success"></i>&nbsp;@subMenu.SubModulo</a></li>
            }
        </ul>
    }
}


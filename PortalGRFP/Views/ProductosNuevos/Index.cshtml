
@{
    ViewBag.Title = "Reportes/Productos Nuevos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<body>
    <a href='@Url.Action("DescargarExcel",new {})'  class="btn btn-success btn-lg" title="Descargar Reporte">
        Descargar Reporte
        <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-box-arrow-in-down" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M3.5 6a.5.5 0 0 0-.5.5v8a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-8a.5.5 0 0 0-.5-.5h-2a.5.5 0 0 1 0-1h2A1.5 1.5 0 0 1 14 6.5v8a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 14.5v-8A1.5 1.5 0 0 1 3.5 5h2a.5.5 0 0 1 0 1h-2z" />
            <path fill-rule="evenodd" d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z" />
        </svg>
    </a>
   <!-- <button id="btnDownload" type="button" class="btn btn-success btn-lg">Descargar Reporte</button>-->
    <div class="col-lg-12" style="margin-top:5%">
        <div class="row">
            <div class="table-responsive" id="dtDivProd">
                <table class="table table-striped" id="dtDataProd">
                    <thead class="thead-primary">
                        <tr>
                            <th>&nbsp;</th>
                            <th scope="col">Sku</th>
                            <th scope="col">Descripcion</th>
                            <th scope="col">Grupo</th>
                            <th scope="col">Familia</th>
                            <th scope="col">Categoria</th>
                            <th scope="col">Clasificacion</th>
                            <th scope="col">Fecha Sincronización</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model)
                        {
                        <tr>
                            <td>&nbsp;</td>
                            <td>
                                @d.Sku
                            </td>
                            <td>
                                @d.Descripcion
                            </td>
                            <td>
                                @d.Grupo
                            </td>
                            <td>
                                @d.Familia
                            </td>
                            <td>
                                @d.Categoria
                            </td>
                            <td>
                                @d.Clasificacion
                            </td>
                            <td>
                                @d.Fecha
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>

@section scripts{
    <script>

        
        showLoading();
            $(function () {
                'use strict'           
                $('#dtDataProd').dataTable(                
                {                
                    language: {
                        url: 'https://cdn.datatables.net/plug-ins/1.10.15/i18n/Spanish.json',
                        searchPlaceholder: "Buscar",
                        sSearch: '',
                        lengthMenu: '_MENU_ filas / paginas'
                    }
                    });
                hideLoading();
            });
           $("#btnDownload").click(function () {
               $.post('@Url.Action("DescargarExcel", "ProductosNuevos")', { flag: "prod" }, function (data) {
               });
           });

        function getAbsolutePath() {
            var loc = window.location;
            var pathName = loc.pathname.substring(0, loc.pathname.lastIndexOf('/') + 1);
            return loc.href.substring(0, loc.href.length - ((loc.pathname + loc.search + loc.hash).length - pathName.length));
        }

    </script>
}
@model PortalGRFP.Entities.Common.SugeridoFiltros
@using PortalGRFP.Entities.Common

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>Sugerido de Compra</a></li>
    <li class="breadcrumb-item"><a>Consulta Sugerido</a></li>
}
<label>ID: @TempData["IdSugerido"].ToString()</label>
@using (Html.BeginForm("DescargarExcel", "ValidaSugerido", FormMethod.Post, new { role = "form", id = "frmSugerido" }))
{
    <div class="row">
        <div class="col-md-2">
            Fecha
            <input type="date" id="Fecha" name="Fecha" class="form-control" min="@{DateTime.Now.AddDays(-7).ToShortDateString();} " />
        </div>
        <div class="col-md-2">
            Sucursales/Grupo
            <select id="GrupoSuc" name="GrupoSuc" multiple="multiple" class="form-control col-md-10">
                @{
                    var sucGrups = TempData["SucGruposTMP"] as List<MultiselectAgrupado>;
                    var numeroGrupos = (from sg in sucGrups select sg.IdGrupo).ToList().Max();

                    for (int i = 0; i <= numeroGrupos; i++)
                    {

                        var sgrupo = (from t in sucGrups where t.IdGrupo == i select t.Grupo).FirstOrDefault();
                        if (sgrupo != null)
                        {


                            var opciones = (from t in sucGrups where t.IdGrupo == i select new ComboGenerico { Id = t.IdSucursal, Valor = t.Sucursal }).ToList();

                            <optgroup label="@sgrupo.ToString()" class="group-1">

                                @foreach (var item in opciones)
                                {
                                    <option value="@item.Id">@item.Valor</option>
                                }

                            </optgroup>
                        }

                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            Proveedores
            <select id="Proveedor" name="Proveedor" multiple="multiple" class="form-control">
                @foreach (var item in TempData["ProveedorTMP"] as List<ComboGenerico>)
                {
                    <option value="@item.Id">@item.Valor</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            Tipo Calculo
            <select id="TipoCalculo" name="TipoCalculo" multiple="multiple" class="form-control">
                <option value="1">PVD</option>
                <option value="2">Invenadro</option>
            </select>
        </div>
        <div class="col-md-2">
            Status Sugerido
            <select id="EstatusSug" name="EstatusSug" multiple="multiple" class="form-control">
                @foreach (var item in TempData["EstatusSug"] as List<ComboGenerico>)
                {
                    <option value="@item.Id">@item.Valor</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            Grupo
            <select id="GrupoArt" name="GrupoArt" multiple="multiple" class="form-control">
                @foreach (var item in TempData["GpoArticulos"] as List<ComboGenerico>)
                {
                    <option value="@item.Id">@item.Valor</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            Tipo Pedido
            <select id="Conceptos" name="Conceptos" multiple="multiple" class="form-control">
                @*<option value="1">Negados</option>
                    <option value="2">Compra Especial</option>
                    <option value="3">Resurtido Natural</option>
                    <option value="4">Invenadro</option>
                    <option value="5">Especiales Farmacia</option>
                    <option value="6">Pie de Camión Mayorista</option>*@
                @foreach (var item in TempData["ReglasSug"] as List<ComboGenerico>)
                {
                    <option value="@item.Id">@item.Valor</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="button" class="btn-dark" id="btnRechazos">Rechazados</button>
        </div>
        <div class="col-md-2">
            Consultar
            <select id="Consulto" name="Consulto" class="form-control">
                <option value="1">Resumen(Producto/Proveedor)</option>
                <option value="2">Detallado</option>
            </select>
        </div>
        <div class="col-md-2">
            <input type="button" value="Consultar" id="btnBuscar" class="btn btn-primary" style="margin-top:25px" />
            <input type="submit" value="Excel" id="btnDescargar" title="Descargar" class="btn btn-warning" style="margin-top:25px" />
        </div>
        <div class="col-md-3">
            <label>Resumen de Sugerido</label>
            <select id="resumenSug" name="resumenSug" class="form-control">
                <option value="1">Todos</option>
                <option value="2">Provedor</option>
                <option value="3">Proveedor Sucursal</option>
                <option value="4">Tipo Compra</option>
            </select>
        </div>
        <div>
            <button type="button" title="Eliminar Sugerido" class="btn btn-sm pd-x-15 btn-danger btn-lg aligned-right" style="margin-top:30px" id="EliminarRenglon">
                <i class="fa fa-trash" aria-hidden="true"></i>
            </button>
        </div>
    </div>

    <input type="hidden" id="idSugerido" name="idSugerido" value="@TempData["IdSugerido"].ToString()" />

}

<div class="container-fluid">
    <div class="col-md-1">
        <a href="/Sugerido/ListaSugerido/" class="btn btn-sm pd-x-15 btn-primary float-left" title="Regresar"><i class="fa fa-reply" aria-hidden="true"></i></a>
    </div>
    <div class="col-md-7"></div>
    <div class="col-md-4 float-right">
        <table id="tblmontos">
        </table>
    </div>
</div>


<div class="container-fluid overflow-auto" id="detalle">
    <table id="listSugerido" class="table-striped compact" width="100%"></table>
</div>
<div class="container-fluid overflow-auto" id="resumen" style="display:none">
    <table id="tblResumenProveedor" class="table-striped compact" width="100%"></table>
</div>
<div class="container-fluid overflow-auto" id="rechazos" style="display:none">
    <table id="tblRechazos" class="table-striped compact" width="100%"></table>
</div>

@section scripts{
    <script>
        function sumarDias(fecha, dias) {
            fecha.setDate(fecha.getDate() + dias);
            return fecha;
        }
        var d = new Date();
        document.getElementById("Fecha").min = sumarDias(d, -7);

        $(document).ready(function () {
            'use strict';

            $('#GrupoSuc').multiselect({

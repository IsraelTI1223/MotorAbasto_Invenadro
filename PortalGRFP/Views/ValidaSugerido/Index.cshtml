                });


        }

        function getDTCuenta() {
            showLoading();
            $('#cbIncidencias').empty();
            $.ajax({
                type: "POST",
                url: "/ValidaSugerido/GetDTCuenta",
                dataType: "json",
                success: function (data) {
                    $("#contenedor_tb2").show();
                    hideLoading();

                    console.log(data)       

                    hideLoading();

                    $('#tbCuenta').DataTable({
                        data: data.Result,
                        "destroy": true,
                        "processing": true,
                        dom: 'Bfrtip',
                        columns: [
                            { data: "idSugerido", title: 'idSugerido' },                          
                            { data: "idSucursal", title: "idSucursal" },
                            { data: "id_proveedor", title: "id_proveedor" },
                            { data: "CADENA", title: "CADENA" },
                            { data: "RAZON_SOCIAL", title: "RAZON_SOCIAL" },
                            { data: "Desc_tienda", title: "Desc_tienda" },
                            { data: "Desc_proveedor", title: "Desc_proveedor" }
                        ],
                        select: true,
                        scrollCollapse: true,
                        info: false,
                        paging: true,
                        responsive: true,
                        searching: true
                    });
                    if (data.length == 0) {
                        swal("No se encontraron incidencias", '', "warning");
                    }
                },
                error: function (response) {
                    hideLoading();
                    swal("¡Error inesperado " + response, '', "error");


                }
            });
        }




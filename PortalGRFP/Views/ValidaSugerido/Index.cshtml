            $("#CalcularSugerido").click(function () {
                showLoading();

                $.ajax({
                    type: "Post",
                    url: "@Url.Action("CalcularSugerido", "ValidaSugerido")",
                    dataType: "json",
                    //data: {Sugerido: idUsugerido},
                    success: function (response) {
                        hideLoading();
                        if (response.Success) {
                            $("#CalcularSugerido").css("display", "none");
                            $("#AsignacionProv").css("display", "block");
                            swal('', response.Message, "success");
                        } else{
                            swal('', response.Message, "warning");
                            //$("#CalcularSugerido").css("display", "none");
                        }
                    },
                    error: function (response) {
                        hideLoading();
                        swal('', response.Message, "warning");
                    }
                });
            });

     

            $("#AsignacionProv").click(function () {




                showLoading();

                $.ajax({
                    type: "Post",
                    url: "@Url.Action("AsignacionProveedor", "ValidaSugerido")",
                    dataType: "json",
                    //data: {Sugerido: idUsugerido},
                    success: function (response) {
                        hideLoading();

                        var ids = response.Message.split('-')[1];
                        console.log("_" + ids)
                        


                        swal("Proveedor Asignado", response.Message.split('-')[0], "success").then((value) => {

                            location.href = '@Url.Action("ValidarMontosSugerido", "Sugerido")?IdSugerido=' + ids;

                        });



                    },
                    error: function (response) {
                        hideLoading();
                        swal('', response.Message, "warning");
                    }
                });
            });

        });


        function getLogError() {
            console.log(sucursalesG);
             showLoading();
             $.ajax({
                    url: "@Url.Action("GetListLogError", "ValidaSugerido")",
                 dataType: "json",
                 data: { incidencia: $("#cbIncidencias option:selected").text(), tiendas: sucursalesG },
                    success: function (data) {
                        console.log(data)

                        hideLoading();

                        $('#tbLogerror').DataTable({
                            data: data,
                            "destroy": true,
                            "processing": true,
                            dom: 'Bfrtip',
                            columns: [
                                { data: "FechaCarga", title: 'FechaCarga' },

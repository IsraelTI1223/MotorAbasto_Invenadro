<div class="col-lg-12">

    <input type="hidden" value="@ViewBag.IdPerfil" id="IdPerfil" />

    <div class="form-group">

        @if (ViewBag.IdPerfil == 1)
        {


            <b>  <label>Seleccione una razon social:</label></b>
            <select class="form-control" id="subtipo">

                <option value="0">Selecciona una razon social</option>
                @foreach (var subCliente in ViewBag.SubClientes)
                {
                    <option value="@subCliente.IdTipo">@subCliente.Descripcion</option>
                }

            </select>
            <br />



            <div class="form-row">
                @if (ViewBag.IdPerfil == 1)
                {
                   <div class="col-md-6 mb-3">


                       <b><label   id="TipoCliente">Seleccione un subcliente: </label></b>

                       <b><label  style="display: none" id="TipoSubCliente">Seleccione un cliente:</label></b>
                        <select class="form-control" id="selectCliente">

                              <option value="0">SUBCLIENTES</option>
 
                                @if (ViewBag.Clientes != null)
                                 {
                                    foreach (var cliente in ViewBag.Clientes)
                                    {
                                      <option value="@cliente.IdCliente">@cliente.RFC @cliente.SubCliente</option>
                                    }
                                 }

                         </select>

                   </div>

                    <div class="col-md-6 mb-3" style="display: none" id="IdSubTipoPerfil">

                        <b><label>Seleccione un subcliente:</label></b>

                        <select class="form-control" id="selectSubCliente">

                            <option>SUBCLIENTES</option>

                        </select>

                    </div>

                }
            </div>

        }

    </div>



    <div class="form-row">
        @if (ViewBag.IdPerfil == 3)
        {

             <div class="col-md-6 mb-3">

                  <b>  <label>Seleccione una razon social:</label></b>

                  <select class="form-control" id="subtipo">

                     <option value="0">Selecciona una razon social</option>
                      @foreach (var subCliente in ViewBag.SubClientes)
                       {
                         <option value="@subCliente.IdTipo">@subCliente.Descripcion</option>
                       }

                 </select>
               <br />
             </div>


                <div class="col-md-6 mb-3">

                    <b><label>Seleccione un subcliente:</label></b>

                    <select class="form-control" id="selectCliente">

                        <option value="0">SUBCLIENTES</option>

                        @if (ViewBag.Clientes != null)
                        {
                            foreach (var cliente in ViewBag.Clientes)
                            {
                                <option value="@cliente.IdCliente">@cliente.RFC @cliente.SubCliente</option>
                            }
                        }

                    </select>

                </div>
         }
    </div>


            <div class="form-group">


                @if (ViewBag.IdPerfil != 3 && ViewBag.IdPerfil != 1 && ViewBag.IdPerfil != 4)
                {
                    <b><label>Seleccione un subcliente:</label></b>

                    <select class="form-control" id="selectCliente">

                        <option value="0">SUBCLIENTES</option>

                        @if (ViewBag.Clientes != null)
                        {
                            foreach (var cliente in ViewBag.Clientes)
                            {
                                if (ViewBag.IdPerfil == 2)
                                {
                                    <option value="@cliente.IdCliente"> @cliente.SubCliente - RFC:@cliente.RFC</option>
                                }

                                if (ViewBag.IdPerfil == 4)
                                {
                                    <option value="@cliente.IdCliente">@cliente.Nombre - RFC:@cliente.RFC</option>
                                }

                            }
                        }

                    </select>

                    <br />
                }

            </div>

            <div class="form-row">
                @if (ViewBag.IdPerfil == 4)
                {
                    <div class="col-md-6 mb-3">

                        <b><label>Seleccione un cliente:</label></b>



                        <select class="form-control" id="selectCliente">

                            <option value="0">CLIENTES</option>

                            @if (ViewBag.Clientes != null)
                            {
                                foreach (var cliente in ViewBag.Clientes)
                                {
                                    if (ViewBag.IdPerfil == 2)
                                    {
                                        <option value="@cliente.IdCliente"> @cliente.SubCliente - RFC:@cliente.RFC</option>
                                    }

                                    if (ViewBag.IdPerfil == 4)
                                    {
                                        <option value="@cliente.IdCliente">@cliente.Nombre - RFC:@cliente.RFC</option>
                                    }

                                }
                            }

                        </select>

                        <br />

                    </div>


                    <div class="col-md-6 mb-3" style="display: none" id="IdSubTipoPerfil">

                        <b><label>Seleccione un subcliente:</label></b>

                        <select class="form-control" id="selectSubCliente">

                            <option>SUBCLIENTES</option>

                        </select>
                    </div>

                }
            </div>

            <div class="row">

                <div class="table-responsive">
                    <table class="table table-striped"  cellspacing="0" width="100%" id="tbulkLoadDiscount">
                        <thead class="thead-primary">
                            <tr>
                                <th scope="col">Tipo Carga</th>
                                <th scope="col">Nombre Archivo</th>
                                <th scope="col">Nombre Cliente</th>
                                <th scope="col">Nombre Subcliente</th>
                                <th scope="col">Usuario Registro</th>
                                <th scope="col">Fecha</th>
                                @*<th scope="col">Registros</th>*@
                                <th scope="col">Cargados</th>
                                <th scope="col">Errores</th>
                                @*<th scope="col"></th>*@
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Success)
                            {
                                foreach (var d in Model.Result)
                                {
                                    <tr>
                                        <th scope="row">@d.TipoCarga</th>
                                        <td>@d.NombreArchivo</td>
                                        <td>@d.NombreCliente</td>
                                        <td>@d.NombreSubCliente</td>
                                        <td>@d.UsuarioRegistro</td>
                                        <td>@d.FechaRegistro</td>
                                        @*<td>@d.TotalRegistros</td>*@
                                        <td>@d.TotalCargados</td>
                                        <td>@d.TotalErroneos</td>
                                        @*<td>
                                        </td>*@
                                    </tr>
                                   
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


  

    <style>
       /* .dtHorizontalExampleWrapper {
            max-width: 600px;
            margin: 0 auto;
        }*/

        #tbulkLoadDiscount th, td {
            white-space: nowrap;
        }

      
    </style>


    @Html.Partial("_UploadFileModal")

    @section scripts{
        <script type="text/javascript" src="~/Scripts/App/Views/bulkLoadDiscount.js"></script>
        @*<script type="text/javascript" src="~/Scripts/App/Views/TablaScroll.js"></script>*@

    }

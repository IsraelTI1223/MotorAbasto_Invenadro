@model PortalGRFP.Entities.Response.ResponseList<PortalGRFP.Entities.Common.DescuentoHdr>
@{
    ViewBag.Title = DateTime.Now.ToShortDateString() + " Archivos cargados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>CADENA DE VALOR</a></li>
    <li class="breadcrumb-item active"><a>COMERCIAL</a></li>
    <li class="breadcrumb-item active"><a>DESCUENTOS</a></li>
}

@*@section Styles{
    
    <link style="" href="~/lib/Table-CSS/DiseñoTable.css"/>
    
    }*@

@section Actions{
    @if (((Dictionary<int, string>)ViewBag.Actions).ContainsKey(3))
    {

        //<button class="btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" id="btnUploadFileModal" data-toggle="modal" data-target="#uploadFileModal">

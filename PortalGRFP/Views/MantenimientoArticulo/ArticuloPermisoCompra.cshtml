        </div>
        <div class="card-body">
            <table id="tblAgencia" class="display compact cell-border" width="100%"></table>
        </div>
    </div>
</div>
<div class="modal fade" id="modalExcel" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <form id="frmExcel" enctype="multipart/form-data" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalExcel-label">Cargar Excel</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="custom-file">
                        <input onchange="setTextInputFile(event)" type="file" class="custom-file-input" id="fileExcel" name="fileExcel" multiple data-show-upload="false">
                        <label id="lblFileName" class="custom-file-label" for="customFile">Seleccionar archivo</label>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="EnviarExcel">Iniciar Carga</button>
                </div>
            </div>
        </form>
    </div>
</div>




@section scripts{
    <script>


        var _descripcion;var _sku;


        $("#frmSendData").hide();
       // $('#tblAgencia').hide();

        $('#cbTiendas').multiselect({ enableFiltering: true,includeSelectAllOption: true, selectAllText: "Marcar Todas", allSelectedText: "Todas Seleccionadas", nonSelectedText: "Seleccionar Tienda", nSelectedText: "Tiendas Seleccionadas" });


        $(document).ready(function () {


            function file_onChage(e) {
                $lblFileName.text((e.target.files.length > 0) ? e.target.files[0].name : 'Seleccionar archivo');
                console.log("entre file change")

            }

            var $lblFileName = $('#lblFileName');

            function bindEvents() {
                console.log("entre bing")
                $('#fileExcel').bind('change', file_onChage);
            }




            $("#EnviarExcel").click(function () {

                var formulario = document.getElementById('frmExcel');
                var archivo = $("#fileExcel").val();
                if (archivo != "") {
                    showLoading();
                    var formData = new FormData(formulario);
                    $.ajax({
                        type: "POST",
                        url: "/MantenimientoArticulo/CargarExcel",
                        processData: false,
                        contentType: false,
                        data: formData,
                        success: function (response) {
                            hideLoading();
                            if (response.Success) {
                                $("#modalExcel").modal('hide');
                                swal(response.Message, '', "success").then((value) => {
                                    $("#frmSendData").show();
                                    //window.location.href = "/ConciliacionRappi/Index";
                                });
                            } else {
                                swal(response.Message, '', "error");
                            }
                        },
                        error: function (e) {
                            hideLoading();
                            swal("¡Error inesperado en la carga!", '', "error");
                        }

                    })
                } else {
                    swal("¡No se ha seleccionado un archivo!", '', "error");
                }
            });




            $("#frmSendData").submit(function (e) {
                e.preventDefault();



                if ($("#cbActivaCompra:checked").val() == undefined && $("#cbNoActivaCompra:checked").val() == undefined) {
                    alert("Seleccione una opcion para compra");
                    return;
                }

                if ($("#cbActivaVenta:checked").val() == undefined && $("#cbNoActivaVenta:checked").val() == undefined) {
                    alert("Seleccione una opcion para venta");
                    return;
                }

                if (confirm("Vas guardar información, ¿Seguro de continuar?")) {


                    var formData = new FormData();


                    if ($("#cbActivaCompra:checked").val() == 'on') {
                        formData.append("Compra", true);
                    } else {
                        formData.append("Compra", false);
                    }

                    if ($("#cbActivaVenta:checked").val() == 'on') {
                        formData.append("Venta", true);
                    } else {
                        formData.append("Venta", false);
                    }


                    showLoading();
                    $.ajax({
                        type: "POST",
                        url: "/MantenimientoArticulo/GuardarPermisoCompra",
                        processData: false,
                        contentType: false,
                        data: formData,
                        success: function (response) {
                            hideLoading();
                            if (response.Success) {

                                swal(response.Message, '', "success").then((value) => {
                                    //window.location.href = "/ConciliacionRappi/Index";
                                    $('input[name="cbActivaCompra"]').prop('checked', false);
                                    $('input[name="cbActivaVenta"]').prop('checked', false);
                                    $("#fileExcel").val("");
                                    $("#frmSendData").hide();
                                    $('#lblFileName').text("");
                                    getLogErrorpermisoCompra();

                                    //$('#tblAgencia').show();




                                });
                            } else {
                                swal(response.Message, '', "error");
                            }
                        },
                        error: function (e) {
                            hideLoading();
                            swal("¡Error inesperado en la carga!", '', "error");
                        }

                    })

                }


            });



            function getLogErrorpermisoCompra() {
                'use strict'

            $('#tblAgencia').DataTable({
                "ajax": {
                    "url": "@Url.Action("ConsultarLogError", "MantenimientoArticulo")",
                    "dataSrc": "",
                },//response.Result,
                "destroy": true,
                "processing": true,
                dom: 'Bfrtip',
                columns: [
                    { data: "IdSucursal", title: 'Id Sucursal' },
                    { data: "SKU", title: "SKU" },
                    { data: "oEx", title: "Motivo de rechazo" }],
                select: true,
                scrollCollapse: true,
                info: false,
                paging: true,
                responsive: true,
                searching: true});


            }

            $("#cbCadenas").on("change", function () {


                var data = new FormData();

                data.append("cadena", $("#cbCadenas").val());

                getSucursalesCadenas(data);
            });


            function getSucursalesCadenas(data) {

                //console.log("la data " + JSON.stringify(data))
                showLoading();
                $('#cbTiendas').empty();
                $.ajax({
                    type: "POST",
                    url: "/MantenimientoArticulo/GetSucursalesXCadena",
                    data: data,
                    dataType: "json",
                    processData: false,  // tell jQuery not to process the data
                    contentType: false,
                    success: function (response) {
                        hideLoading();
                        var sucursales = "";
                        for (var i = 0; i < response.data.length; i++) {
                            sucursales = sucursales + '<option value=' + response.data[i].ID + '>' + response.data[i].Valor + '</option>';
                        }


                        $("#cbTiendas").append(sucursales);

                        $('#cbTiendas').multiselect('rebuild');



                    },
                    error: function (response) {
                    }
                });

            }

           // $("#btnGurdar").click(function () {
            $("#txtSku").focusout(function () {
                setValueComponents();
            });

            $("#txtDescripcion").focusout(function () {
                setValueComponents();
            });

            function setValueComponents() {
                $("#txtSku").val(_sku);
                $("#txtDescripcion").val(_descripcion);
            }

            $("#frm_PC").submit(function (e) {

                e.preventDefault();


                if ($("#cbActivaCompraXS:checked").val() == undefined && $("#cbNoActivaCompraXS:checked").val() == undefined) {
                    alert("Seleccione una opcion para compra");
                    return;
                }

                if ($("#cbActivaVentaXS:checked").val() == undefined && $("#cbNoActivaVentaXS:checked").val() == undefined) {
                    alert("Seleccione una opcion para venta");
                    return;
                }


                //if ($("#txtSku").val() != "") {
                //    alert("Sku es obligatorio");
                //}




                if (confirm("Vas guardar información, ¿Seguro de continuar?")) {

                console.log($("#cbTiendas").val())

                var tiendasArray = [];

                tiendasArray = $("#cbTiendas").val();

                console.log(tiendasArray);

                var formData = new FormData();

                var index = 0;

                for (var i of tiendasArray) {

                    console.log(i)
                    formData.append("Sucursales[" + index + "].ID", i);
                    index++;
                }
                formData.append("Sku", $("#txtSku").val());

                if ($("#cbActivaCompraXS:checked").val() == 'on') {
                    formData.append("Compra", true);
                } else {
                    formData.append("Compra", false);
                }

                if ($("#cbActivaVentaXS:checked").val() == 'on') {
                    formData.append("Venta", true);
                } else {
                    formData.append("Venta", false);
                }


                showLoading();
                $.ajax({
                    type: "POST",
                    url: "/MantenimientoArticulo/GuardarPermisoCompraPorSucursal",
                    processData: false,
                    contentType: false,
                    data: formData,
                    success: function (response) {
                        hideLoading();
                        if (response.Success) {

                            swal(response.Message, '', "success").then((value) => {
                                //window.location.href = "/ConciliacionRappi/Index";

                                $('#cbCadenas').prop('selectedIndex', 0);

                                $("#cbTiendas").val("");
                                $('#cbTiendas').multiselect('rebuild');

                                $('input[name="cbActivaCompraXS"]').prop('checked', false);
                                $('input[name="cbActivaVentaXS"]').prop('checked', false);
                                $("#txtSku").val("");
                                $("#txtDescripcion").val("");

                                $('input[name="cbActivaCompra"]').prop('checked', false);
                                $('input[name="cbActivaVenta"]').prop('checked', false);
                                $("#fileExcel").val("");
                                $("#frmSendData").hide();
                                $('#lblFileName').text("");

                               // $('#tblAgencia').dataTable().clear();

                                //$('#tblAgencia').hide();
                                $("#frmSendData").hide();

                               //var table = $('#tblAgencia').DataTable();

                                //clear datatable
                                //table.clear().draw();



                            });
                        } else {
                            swal(response.Message, '', "error");
                        }
                    },
                    error: function (e) {
                        hideLoading();
                        swal("¡Error inesperado en la carga!", '', "error");
                    }
                })
                }
            });


               $("#txtSku").autocomplete({
                source: function (request, response) {
                    //minLength: 4,
                    $.ajax({
                        url:"@Url.Action("AutocommpleteSKU", "MantenimientoArticulo")",
                        type: "POST",
                        dataType: "json",
                        data: { texto: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.Valor };
                            }))
                        }
                    })
                },
                select: function (event, ui) {
                    //console.log("sku--->" + ui.item.value.split(',')[0]);

                    _sku = ui.item.value.split(',')[0];

                     $.ajax({
                        url: "@Url.Action("GetProductoBySku", "MantenimientoArticulo")",
                        type: "POST",
                        dataType: "json",
                        data: { texto: ui.item.value.split(',')[0] },
                        success: function (data) {

                            $("#txtDescripcion").val(data.Descripcion);
                            _descripcion = data.Descripcion;
                        }
                    });
                }
            });

            $("#txtDescripcion").autocomplete({
                source: function (request, response) {
                    minLength: 5,
                    $.ajax({
                        url: "@Url.Action("AutocommpleteDESC", "MantenimientoArticulo")",
                        type: "POST",
                        dataType: "json",
                        data: { texto: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.Valor };
                            }))
                        }
                    })
                },
                select: function (event, ui) {
                    _descripcion = ui.item.value.split(',')[0];
                    $.ajax({
                        url: "@Url.Action("GetProductoByDesc", "MantenimientoArticulo")",
                        type: "POST",
                        dataType: "json",
                        data: { texto: ui.item.value.split(',')[0] },
                        success: function (data) {
                            $("#txtSku").val(data.Sku);
                            _sku = data.Sku;
                        }
                    });

                }
            });


        });

        function setTextInputFile(e) {
            $('#lblFileName').text((e.target.files.length > 0) ? e.target.files[0].name : 'Seleccionar archivo');
        }

      


    </script>
}





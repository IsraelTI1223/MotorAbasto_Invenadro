                return;
            }
            var activocompra = $("#cbActivaCompra").val();

            if ($("#cbActivaCompra:checked").val() == "on" && $("#cbNoActivaVenta:checked").val() == "on") {
                swal("Error","No se pueden desactivar permisos de venta si los permisos de compra están activos", "error");
                return;
            }

            console.log($("#fileExcel").val())

            if ($("#fileExcel").val() == '') {
                swal("","Seleccione Archivo","error");
                return;
            }

            if (confirm("Vas guardar información, ¿Seguro de continuar?")) {

                var formData = new FormData();

                if ($("#cbActivaCompra:checked").val() == 'on') {
                    formData.append("Compra", true);

        function GetArticulosVenta(articulo) {
            console.log($("#cbTiendasVenta").val())

            if ($("#cbTiendasVenta").val().length = 0 || $("#txtSkuVenta").val() == '') {
                swal('Mensaje', 'Seleccione todos los parametros de busqueda', "warning");
                return;
            }

            showLoading();

            $.ajax({
                url: "@Url.Action("GetPermisosArticuloSucursal", "MantenimientoArticulo")",
                type: "POST",
                dataType: "json",

                data: { sku: articulo, sucursales: String($("#cbTiendasVenta").val()) },
                success: function (data) {
                    hideLoading();

                    if (data.Success) {

                        dtapiV = null;
                        dtapiV = $('#dtPermisoVenta').DataTable({
                            data: data.Result,
                            "destroy": true,
                            "processing": true,
                            dom: 'Bfrtip',
                            "drawCallback": function (settings) {
                                if (dtapiV) {
                                    var visibleRows = $("td.cbcell").closest("tr");
                                    visibleRows.each(function (i, item) {
                                        $("td.cbcell input", item).prop("checked", dtapiV.rows(item).data()[0].isChecked);
                                    });
                                }
                            },
                            columns: [
                                {
                                    "data": "isChecked",
                                    "class": "cbcell",
                                    "orderable": false,
                                    "title": "<input type='checkbox' />",
                                    "render": function (data, type, row) {
                                        if (row.ActivoVenta =='Activo')
                                            return "<input checked type='checkbox'/>";
                                        else
                                            return "<input type='checkbox'/>";
                                    }
                                },
                                { data: "Cadena", title: 'Cadena' },
                                { data: "IdSucursal", title: 'Id Sucursal' },
                                { data: "Sucursal", title: 'Sucursal' },
                                { data: "SKU", title: 'SKU' },
                                { data: "DESCRIPCION", title: 'Descripción' },
                                { data: "ActivoVenta", title: 'Activo Venta' },
                                { data: "ActivoCompra", title: 'Activo Compra' }

                            ],
                            select: true,
                            scrollCollapse: true,
                            info: false,
                            paging: true,
                            responsive: true,
                            searching: true
                        });

                        //validamos si viene por lo menos un inactivo desmarcamos el check del cabecero
                        var dt = $('#dtPermisoVenta').DataTable().data();

                        $("th input[type=checkbox]").prop("checked", true);

                        var c = 0;
                        for (var i = 0; i < dt.length; i++) {
                            if (dt[i].ActivoVenta == 'Inactivo')
                            {
                                c++;
                            }
                        }
                        if (c > 0) {
                            $("th input[type=checkbox]").prop("checked", false);
                        }

                            $("th input[type=checkbox]").on("click", function () {
                                var isChecked = this.checked;
                                var ld = $('#dtPermisoVenta').DataTable().rows().data();
                                $.each(ld, function (i, item) {
                                    item.isChecked = isChecked;
                                });
                                $(".cbcell input").prop("checked", isChecked);
                            });

                        if (fillInDTVT == 0) {
                            $("#dtPermisoVenta").on("click", "td input[type=checkbox]", function () {

                                var isChecked = this.checked;

                                var dtRow = dtapiV.rows($(this).closest("tr"));

                                dtRow.data()[0].isChecked = isChecked;

                                if (!isChecked) {


                                    $("th input[type=checkbox]").prop("checked", false);
                                }
                                else {

                                    $("th input[type=checkbox]").prop("checked", true);
                                    $.each(dtapiV.data(), function (i, item) {

                                        if (item.isChecked == false) {

                                            $("th input[type=checkbox]").prop("checked", false);
                                            return false;
                                        } else if (item.isChecked == undefined && item.ActivoVenta == 'Inactivo') {
                                            $("th input[type=checkbox]").prop("checked", false);
                                            return false;
                                        }
                                    });
                                }

                            });
                        }
                        fillInDTVT = fillInDTVT + 1;

                    }
                },
                error: function (response) {
                    hideLoading();
                    swal("Error al consultar Articulos", 'Error al consultar los articulos en las sucursales', "error").then((value) => {
                        location.reload();
                    });
                }
            });
        }




@model PortalGRFP.Entities.Common.MantenimientoArticulo.ArticuloTipoCompraModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>Mantenimiento</a></li>
    <li class="breadcrumb-item"><a>Articulos</a></li>
    <li class="breadcrumb-item"><a>Tipos de compra</a></li>
}

<div class="card" style="width:100%">
    <div class="card-header">
        <div class="row">
            <div class="col-md-3">
                <label class="control-label col-md-12">SKU</label>
                <input type="Text" class="form-control" id="txtSku" name="txtSku" placeholder="Buscar SKU" />
            </div>
            <div class="col-md-5">
                <label class="control-label col-md-12">Descripción</label>
                <input type="Text" class="form-control" id="txtDescripcion" name="txtDescripcion" placeholder="Buscar por descripción" />
            </div>
            <div class="col-md-2" style="margin-top: 2.5%">
                <!--<div class="custom-control custom-checkbox form-group">
                    <label class="custom-control-label" for="cbCompEmpa">Comp. Por Empaque</label>
                     <input readonly type="checkbox" class="custom-control-input" id="cbCompEmpa">
                </div>-->

                <div class="custom-control custom-checkbox form-group">
                    <input onclick="return false;" type="checkbox" class="custom-control-input" id="cbCompEmpa">
                    <label class="custom-control-label" for="cbCompEmpa">Comp. Por Empaque</label>
                </div>
            </div>
            <div class="col-md-2">
                <label class="control-label col-md-12">Factor de empaque:</label>
                <input readonly type="Text" class="form-control" id="txtFactorEmpaque" name="txtFactorEmpaque" placeholder="" />
            </div>

        </div>
        <div class="row" style="margin-top:1%">
            <div class="col-md-4">
                <label class="control-label col-md-12">Tipo Prov FR:</label>
                <input readonly type="Text" class="form-control" id="txtTipoProvFR" name="txtTipoProvFR" placeholder="" />
            </div>
            <div class="col-md-4">
                <label class="control-label col-md-12">Tipo Prov LD:</label>
                <input readonly type="Text" class="form-control" id="txtTipoProvLD" name="txtTipoProvLD" placeholder="" />
            </div>
            <div class="col-md-4">
                <label class="control-label col-md-12">Tipo Prov SSAE:</label>
                <input readonly type="Text" class="form-control" id="txtTipoProvSSAE" name="txtTipoProvSSAE" placeholder="" />
            </div>
        </div>

        <div class="row" style="margin-top:1%;">

            <div class="col-md-1" style="margin-top: 2.5%">
                <!--<div class="custom-control custom-checkbox form-group">
                    <label class="custom-control-label" for="cbFFS">F F S</label>
                     <input readonly type="checkbox" class="custom-control-input" id="cbFFS">
                </div>-->

                <div class="custom-control custom-checkbox form-group">
                    <input onclick="return false;" type="checkbox" class="custom-control-input" id="cbFFS">
                    <label class="custom-control-label" for="cbFFS">F F S</label>
                </div>
            </div>
            <div class="col-md-7">
                <label class="control-label col-md-12">Proveedor FFS:</label>
                <input readonly type="Text" class="form-control" id="txtProveedorFFS" name="txtProveedorFFS" placeholder="" />
            </div>
            <div class="col-md-4">
                <label class="control-label col-md-12">Redondeo de Empaque:</label>
                <input readonly type="Text" class="form-control" id="txtRedondeoEmpaque" name="txtRedondeoEmpaque" placeholder="" />
            </div>
        </div>
    </div>

</div>



@section scripts{
    <script>
        $(document).ready(function () {
            'use strict';

            $("#txtSku").autocomplete({
                source: function (request, response) {
                    minLength: 4,
                    $.ajax({
                        url: "@Url.Action("AutocommpleteSKU", "MantenimientoArticulo")",
                        type: "POST",
                        dataType: "json",
                        data: { texto: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.Valor };
                            }))
                        }
                    })
                },
                select: function (event, ui) {
                    console.log("sku--->" + ui.item.value.split(',')[0]);
                     $.ajax({
                        url: "@Url.Action("GetProductoBySku", "MantenimientoArticulo")",
                        type: "POST",
                        dataType: "json",
                        data: { texto: ui.item.value.split(',')[0] },
                        success: function (data) {
                            console.log(data)

                            if (data.FactorEmpaque == "") {
                                $("#cbCompEmpa").prop('checked', false);
                            } else {
                                $("#cbCompEmpa").prop('checked', true);
                            }

                            if (data.Proveedor == "") {
                                $("#cbFFS").prop('checked', false);
                            } else {
                                $("#cbFFS").prop('checked', true);
                            }



                            //$("#txtSku").val(data.Sku);
                            $("#txtDescripcion").val(data.Descripcion);
                            $("#txtFactorEmpaque").val(data.FactorEmpaque);
                            $("#txtTipoProvFR").val(data.FormaSurtirFR);
                            $("#txtTipoProvLD").val(data.FormaSurtirLD);
                            $("#txtTipoProvSSAE").val(data.FormaSurtirSSAE);
                            $("#txtProveedorFFS").val(data.Proveedor);
                           // $("#txtRedondeoEmpaque").val(data.Sku);





                        }
                    });
                }
            });

            $("#txtDescripcion").autocomplete({
                source: function (request, response) {
                    minLength: 5,
                    $.ajax({
                        url: "@Url.Action("AutocommpleteDESC", "MantenimientoArticulo")",
                        type: "POST",
                        dataType: "json",
                        data: { texto: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return { label: item.Valor };
                            }))
                        }
                    })
                },
                select: function (event, ui) {
                    console.log("desc--->" + ui.item.value.split(',')[0]);






                    $.ajax({
                        url: "@Url.Action("GetProductoByDesc", "MantenimientoArticulo")",
                        type: "POST",
                        dataType: "json",
                        data: { texto: ui.item.value.split(',')[0] },
                        success: function (data) {
                            console.log(data)

                            $("#txtSku").val(data.Sku);
                            //$("#txtDescripcion").val(data.Descripcion);
                            $("#txtFactorEmpaque").val(data.FactorEmpaque);
                            $("#txtTipoProvFR").val(data.FormaSurtirFR);
                            $("#txtTipoProvLD").val(data.FormaSurtirLD);
                            $("#txtTipoProvSSAE").val(data.FormaSurtirSSAE);
                            $("#txtProveedorFFS").val(data.Proveedor);

                            if (data.FactorEmpaque == "") {
                                $("#cbCompEmpa").prop('checked', false);
                            } else {
                                $("#cbCompEmpa").prop('checked', true);
                            }

                            if (data.Proveedor == "") {
                                $("#cbFFS").prop('checked', false);
                            } else {
                                $("#cbFFS").prop('checked', true);
                            }
                        }
                    });



                }
            });

        });
    </script>
}
<form method="post" class="form-group col-md-12">

    <div class="form-row">

        <div class="form-group col-md-4">



            <label for="ddlCadena">Buscar Cadena </label>
            <select id="ddlCadena" class="form-control" name="Cadena">
                <option selected>Selecciona...</option>
                @foreach (var item in TempData["Cadena"] as List<ComboGenerico>)
                {
                    <option value="@item.Id">@item.Valor</option>
                }
            </select>
        </div>



        <div class="form-group col-md-3">
            <label for="ddlMarca">Marca </label>
            <select id="ddlMarca" class="form-control" name="Marca">
            </select>
        </div> 
        
        <div class="form-group col-md-3" style="margin-top:2.3%">
            <button type="submit" class="btn btn-primary" >Consultar</button>
        </div>



    </div>




</form>

@if (Model != null) { 


<div class="col-lg-12">
    <div class="row">
        <div class="table-responsive">
            <table class="table table-striped" id="dtDataProd">
                <thead class="thead-primary">
                    <tr>


                        <th scope="col">CADENA</th>
                        <th scope="col">MARCA</th>
                        <th scope="col">SUC_ID</th>
                        <th scope="col">NOMBRE</th>
                        <th scope="col">LICENCIA</th>
                        <th scope="col">SDOM</th>
                        <th scope="col">HRS</th>
                        <th scope="col">INVENADRO</th>
                        <th scope="col">ESTATUS</th>
                        <th scope="col">CIUDAD</th>
                        <th scope="col">ESTADO</th>




                    </tr>
                </thead>
                <tbody>

                    @foreach (var d in Model.Result)
                    {
                        <tr>

                            <td>


                                @d.Cadena
                            </td>
                            <td>
                                @d.Marca
                            </td>
                            <td>
                                @d.Suc_Id
                            </td>


                            <td>
                                @d.Suc_Nombre
                            </td>

                            <td>
                                @d.Licencia
                            </td>
                            <td>
                                @d.Sdom
                            </td>
                            <td>
                                @d.hrs
                            </td>
                            <td>
                                @d.INVENADRO
                            </td>
                            <td>
                                @d.ESTATUS
                            </td>
                            <td>
                                @d.CIUDAD
                            </td>
                            <td>
                                @d.ESTADO
                            </td>





                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>

}
@section scripts{
    <script type="text/javascript" src="~/Scripts/App/Views/CadenaMarca.js"></script>




    <script>

        $(function () {
            'use strict'

            $('#dtDataProd').DataTable({

                select: true,
                scrollCollapse: true,
                info: false,
                paging: true,
                responsive: true,
                searching: true,
                "destroy": true,
                "processing": true,
                dom: 'Bfrtip',
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.10.15/i18n/Spanish.json',
                    searchPlaceholder: "Buscar",
                    sSearch: '',
                    lengthMenu: '_MENU_ filas / paginas'
                }
            }
            );
        });




    </script>

}
@model PortalGRFP.Entities.Response.ResponseList<PortalGRFP.Entities.Common.ResumenCargaRappi>
@using PortalGRFP.Entities.Common
@{
    ViewBag.Title = "Carga Mensual";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>CADENA DE VALOR</a></li>
    <li class="breadcrumb-item"><a>CONCILIACIONES RAPPI</a></li>
}
@section Actions{
    <button type="button" id="btnExcel" class="btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" data-toggle="modal" data-target="#modalExcel" data-placement="top" title="Subir Archivo de Excel">
        <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-cloud-upload" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M4.406 1.342A5.53 5.53 0 0 1 8 0c2.69 0 4.923 2 5.166 4.579C14.758 4.804 16 6.137 16 7.773 16 9.569 14.502 11 12.687 11H10a.5.5 0 0 1 0-1h2.688C13.979 10 15 8.988 15 7.773c0-1.216-1.02-2.228-2.313-2.228h-.5v-.5C12.188 2.825 10.328 1 8 1a4.53 4.53 0 0 0-2.941 1.1c-.757.652-1.153 1.438-1.153 2.055v.448l-.445.049C2.064 4.805 1 5.952 1 7.318 1 8.785 2.23 10 3.781 10H6a.5.5 0 0 1 0 1H3.781C1.708 11 0 9.366 0 7.318c0-1.763 1.266-3.223 2.942-3.593.143-.863.698-1.723 1.464-2.383z" />
            <path fill-rule="evenodd" d="M7.646 4.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 5.707V14.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708l3-3z" />
        </svg> Carga Conciliación mensual
    </button>
}

<div class="col-lg-12">
    <div class="row">
        <div class="table-responsive">
            <table class="table table-striped" id="tblConciliacionVentasMensual">
                <thead class="thead-primary">
                    <tr>
                        <th>&nbsp;</th>
                        <th scope="col">Año</th>
                        <th scope="col">Mes</th>
                        <th scope="col">Lineas</th>
                        <th scope="col">Importe</th>
                        <th scope="col">Carga</th>
                        <th scope="col">% Conciliado</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var d in Model.Result)
                    {
                        <tr>
                            <td>&nbsp;</td>
                            <td>
                                @d.Anio
                            </td>
                            <td>
                                @d.Mes
                            </td>
                            <td>
                                @d.Lineas
                            </td>
                            <td>
                                @d.Importe
                            </td>
                            <td>
                                @d.FechaCarga.ToShortDateString()
                            </td>
                            <td>
                                @d.Porcentaje
                            </td>
                            <td>
                                @if (d.Porcentaje >= 0 && d.Porcentaje <= 99)
                                {
                                    <button type="button" class="ConciliarSistema btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" style="cursor:pointer" data-anio="@d.Anio" data-mes="@d.Mes" title="Conciliar por sistema">
                                        <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-tv" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                            <path fill-rule="evenodd" d="M2.5 13.5A.5.5 0 0 1 3 13h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zM13.991 3H2c-.325 0-.502.078-.602.145a.758.758 0 0 0-.254.302A1.46 1.46 0 0 0 1 4.01V10c0 .325.078.502.145.602.07.105.17.188.302.254a1.464 1.464 0 0 0 .538.143L2.01 11H14c.325 0 .502-.078.602-.145a.758.758 0 0 0 .254-.302 1.464 1.464 0 0 0 .143-.538L15 9.99V4c0-.325-.078-.502-.145-.602a.757.757 0 0 0-.302-.254A1.46 1.46 0 0 0 13.99 3zM14 2H2C0 2 0 4 0 4v6c0 2 2 2 2 2h12c2 0 2-2 2-2V4c0-2-2-2-2-2z" />
                                        </svg>
                                    </button>
                                }
                                @if (d.Porcentaje > 0)
                                {
                                    <a href='@Url.Action("Conciliaciones",new { anio=d.Anio, mes=d.Mes})' class="btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" title="Ventas Pendientes">
                                        <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-eyeglasses" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                            <path fill-rule="evenodd" d="M4 6a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm2.625.547a3 3 0 0 0-5.584.953H.5a.5.5 0 0 0 0 1h.541A3 3 0 0 0 7 8a1 1 0 0 1 2 0 3 3 0 0 0 5.959.5h.541a.5.5 0 0 0 0-1h-.541a3 3 0 0 0-5.584-.953A1.993 1.993 0 0 0 8 6c-.532 0-1.016.208-1.375.547zM14 8a2 2 0 1 0-4 0 2 2 0 0 0 4 0z" />
                                        </svg>
                                    </a>

                                    <a href='@Url.Action("DescargarExcel",new { anio=d.Anio, mes=d.Mes})' class="btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" title="Descargar Conciliación">
                                        <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-box-arrow-in-down" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                            <path fill-rule="evenodd" d="M3.5 6a.5.5 0 0 0-.5.5v8a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-8a.5.5 0 0 0-.5-.5h-2a.5.5 0 0 1 0-1h2A1.5 1.5 0 0 1 14 6.5v8a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 14.5v-8A1.5 1.5 0 0 1 3.5 5h2a.5.5 0 0 1 0 1h-2z" />
                                            <path fill-rule="evenodd" d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z" />
                                        </svg>
                                    </a>
                                }

                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>

<input type="hidden" id="hdnAnio" />
<input type="hidden" id="hdnMes" />
<div class="modal fade" id="modalExcel" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <form id="frmExcel" enctype="multipart/form-data" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalExcel-label">CARGAR UN EXCEL</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="custom-file">
                        <input type="file" class="custom-file-input" id="fileExcel" name="fileExcel" multiple data-show-upload="false">
                        <label id="lblFileName" class="custom-file-label" for="customFile">Seleccionar archivo</label>
                        @*<div id="feedback" class="invalid-feedback">Es necesario seleccionar un archivo</div>*@
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="EnviarExcel">Iniciar Carga</button>
                </div>
            </div>
        </form>
    </div>
</div>


<div class="modal fade" id="modalConciliarAutomaticamente" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <form id="frmExcel" enctype="multipart/form-data" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalExcel-label">Haga Click en la Cadena para conciliar con la aplicación</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <button type="button" class="btn btn-primary col-md-3" id="btnFDU" style="display:none">

@model PortalGRFP.Entities.Response.ResponseList<PortalGRFP.Entities.Common.DetalleInput>
@using PortalGRFP.Entities.Common
@{
    ViewBag.Title = "Consultar Detalle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>CONSULTAR</a></li>
    <li class="breadcrumb-item"><a>DETALLE SINCRONIZACIÓN</a></li>
}
@*<form method="post" class="form-group col-md-12" action="~/MTAConsulta/DetalleConsulta">  *@
<div class="col-lg-12" style="margin-top:5%">
    <div class="row">
        <div class="table-responsive">
            <table class="table table-striped" id="tblConciliacionVentasMensual">
                <thead class="thead-primary">
                    <tr>
                        <th>&nbsp;</th>
                        <th scope="col">ID SUCURSAL</th>
                        <th scope="col">NOMBRE SUCURSAL</th>
                        <th scope="col">MOTIVO</th>
                        <th>&nbsp;</th>

                        @*<th scope="col" style="background-color:salmon">MOTIVO</th>*@



                    </tr>
                </thead>
                <tbody>


                    @foreach (var d in Model.Result)
                    {
                    <tr>
                        <td>&nbsp;</td>
                        <td>
                            @d.CodigoSucursal
                        </td>
                        <td>
                            @d.Nombre_Marca
                        </td>

                        <td>
                            @d.Motivo
                        </td>
                        <td>&nbsp;</td>


                    </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>



@section scripts{
    <script type="text/javascript" src="~/Scripts/App/Views/IndexDetalle.js"></script>
}
@model PortalGRFP.Entities.Response.ResponseList<PortalGRFP.Entities.Common.SincronizacionInput>
@using PortalGRFP.Entities.Common
@{
    ViewBag.Title = "Consultar Inputs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>CONSULTAR</a></li>
    <li class="breadcrumb-item"><a>CONSULTAR LA SINCRONIZACIÓN</a></li>
}



    @*<form method="post" class="form-group col-md-12" action="~/MTAConsulta/DetalleConsulta">  *@
    <div class="col-lg-11">
        <div class="row">
            <div class="table-responsive">
                <table class="table table-striped" id="tblConciliacionVentasMensual">
                    <thead class="thead-primary">
                        <tr>
                            <th>&nbsp;</th>
                            <th scope="col">ID</th>
                            <th scope="col">INPUT</th>
                            <th scope="col">% PORCENTAJE</th>
                            <th scope="col">STATUS</th>
                            <th scope="col">FECHA</th>
                            <th scope="col">INFO</th>


                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var d in Model.Result)
                        {
                        <tr>
                            <td>&nbsp;</td>
                            <td>
                                @d.id_input
                            </td>
                            <td>
                                @d.NameInput
                            </td>
                            <td>
                                @d.Porcentaje
                            </td>

                            <td>

                                @if (d.Porcentaje <= 98)
                                {
                                    <a href='@Url.Action("DetalleConsulta",new { id_input = d.id_input})' class="btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" title="Ver incidencia">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="red" class="bi bi-exclamation-triangle" viewBox="0 0 16 16">
                                            <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.146.146 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.163.163 0 0 1-.054.06.116.116 0 0 1-.066.017H1.146a.115.115 0 0 1-.066-.017.163.163 0 0 1-.054-.06.176.176 0 0 1 .002-.183L7.884 2.073a.147.147 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566z" />
                                            <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995z" />
                                        </svg>
                                    </a>

                                    
                                }

                                @if (d.Porcentaje == 100)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="green" class="bi bi-check2-circle" viewBox="0 0 16 16">
                                        <path d="M2.5 8a5.5 5.5 0 0 1 8.25-4.764.5.5 0 0 0 .5-.866A6.5 6.5 0 1 0 14.5 8a.5.5 0 0 0-1 0 5.5 5.5 0 1 1-11 0z" />
                                        <path d="M15.354 3.354a.5.5 0 0 0-.708-.708L8 9.293 5.354 6.646a.5.5 0 1 0-.708.708l3 3a.5.5 0 0 0 .708 0l7-7z" />
                                    </svg>

                                }
                            </td>

                            <td>
                                @d.Fecha
                            </td>
                          
                            <td>
                                @if (d.id_input == 1)
                                {
                                    <a href='@Url.Action("DetalleCifrasInvenadro",new { id_input = d.id_input})' class="btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" title="Ver detalle">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                            <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                        </svg>
                                    </a>
                                }

                                @if (d.id_input == 4)
                                {
                                    <a href='@Url.Action("DetalleCifrasVenta",new { id_input = d.id_input})' class="btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" title="Ver detalle">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                            <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                        </svg>
                                    </a>
                                }

                                @if (d.id_input == 6)
                                {
                                    <a href='@Url.Action("DetalleCifrasNegados",new { id_input = d.id_input})' class="btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" title="Ver detalle">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                            <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                        </svg>
                                    </a>
                                }

                                @if (d.id_input == 8)
                                {
                                    <a href='@Url.Action("DetalleCifrasTransito",new { id_input = d.id_input})' class="btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" title="Ver detalle">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                            <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                        </svg>
                                    </a>
                                }

                                @if (d.id_input == 9)
                                {
                                    <a href='@Url.Action("DetalleCifrasLista",new { id_input = d.id_input})' class="btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" title="Ver detalle">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                            <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                        </svg>
                                    </a>
                                }
                            </td>
                        </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
  
                    { data: "Sucursal", title: "Sucursal" },
                    {
                        data: "MontoPromedio", title: "Monto Promedio", 'render': function (monto) { return '$ ' + monto; }
                    },
                    {
                        data: "MontoPedido", title: "Monto Pedido", 'render': function (monto) { return '$ ' + monto; }
                        /*render: $.fn.dataTable.render.number(',', '.', 2, '$ ') */ },
                    {
                        data: "MontoFueraLimite", title: "M. Fuera de Limite", 'render': function (monto) { return '$ ' + monto; } },
                    { data: "PorcentajeVariacion",title:"% Variación Fuera de Limite" },
                    { data: "PiezasXFarmacia", title: "Total Piezas Farmacia" },

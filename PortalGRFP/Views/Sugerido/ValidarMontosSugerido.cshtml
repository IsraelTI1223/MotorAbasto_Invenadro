        var _rowsData;

        function ColumnCheck(thisObj) {
            //debugger;
            var dataExchangeCheckColumnVM = $('#tbSugerido').DataTable().row($(thisObj).parents('tr')).data();
            var dataExchangeCheckColumnList = $('#tbSugerido').DataTable().rows().data();
            for (var i = 0; i < dataExchangeCheckColumnList.length; i++) {
                if (dataExchangeCheckColumnList[i].FieldCaption !== null) {
                    //console.log(dataExchangeCheckColumnList[i].Id)
                    //console.log(dataExchangeCheckColumnVM.Id)

                    //if (dataExchangeCheckColumnList[i].FieldCaption === dataExchangeCheckColumnVM) {
                    if (dataExchangeCheckColumnList[i].IdSucursal === dataExchangeCheckColumnVM.IdSucursal) {


                        dataExchangeCheckColumnList[i].ColumnCheck = thisObj.checked;
                    }
                }
            }
            _rowsData = dataExchangeCheckColumnList;

            console.log(_rowsData)
        }


            function validarPermisos() {

                //if (_rowsData == undefined) {
                //    $("#spanTxt").show();
                //    return;
                //}
                $("#spanTxt").hide();


                swal("Validación de Montos", {
                    text: "Ingrese Usuario para autorizar Montos (email corporativo)",
                    icon: "warning",
                    content: "input"
                }).then((value) => {

                    if (value == null) {
                        return;
                    }

                    if (value.length > 3) {

                        $.ajax({
                            url: "@Url.Action("ValidarPermiso", "Sugerido")",
                            type: "POST",
                            dataType: "json",
                            data: { cuenta: value },
                            success: function (response) {
                                hideLoading();

                                if (response.Success) {

                                    swal(response.Message, '', "success").then((value) => {
                                        autorizarMontos();
                                    });
                                } else {
                                    swal(response.Message, '', "error");
                                }
                            },
                            error: function (response) {
                                hideLoading();
                                swal("Error al consultar permisos de validación", '', "error");
                            }
                        });

                    } else {
                        swal("Ingrese una cuenta valida", '', "error");
                    }
                    });

            }

        function autorizarMontos() {

            //if (_rowsData == undefined) {
            //    $("#spanTxt").show();
            //    return;
            //}
            $("#spanTxt").hide();



            swal({
                title: 'Validación de montos',
                text: "¿Validar todo lo Marcado?",
                icon: "warning",
                buttons: {
                    cancel: "Cancelar",
                    catch: {
                        text: "Continuar",
                        value: true
                    }
                },
            }).then((resp) => {

                $("#spanTxt").hide();

                if (resp) {


                    //preguntar si realmente vas a guardar
                    //validar usuario y contraseña para autorizar

                    //var formData = new FormData();

                    //for (var i = 0; i < _rowsData.length; i++) {
                    //    //definir un objeto e irlo llenando dentro de las condiciones

                    //    console.log(_rowsData[i])

                    //    if (_rowsData[i].ColumnCheck === undefined) {
                    //        //console.log("nada para guardar")
                    //        console.log(_rowsData[i].IdSugerido + "," + _rowsData[i].Autorizado);
                    //        formData.append("model[" + i + "].IdSugerido", _rowsData[i].IdSugerido);
                    //        formData.append("model[" + i + "].Idsucursal", _rowsData[i].IdSucursal);
                    //        formData.append("model[" + i + "].Autorizado", _rowsData[i].Autorizado);
                    //       // return;
                    //        // formData.append("Sucursales[" + index + "].ID", i);
                    //    } else {
                    //        console.log(_rowsData[i].IdSugerido + "," + _rowsData[i].ColumnCheck);

                    //        formData.append("model[" + i + "].IdSugerido", _rowsData[i].IdSugerido);
                    //        formData.append("model[" + i + "].Idsucursal", _rowsData[i].IdSucursal);
                    //        formData.append("model[" + i + "].Autorizado", _rowsData[i].ColumnCheck);
                    //    }
                    //}
                    var dt = $('#tbSugerido').DataTable().data();

                    var formData = new FormData();

                    var count = 0;

                    for (var i = 0; i < dt.length; i++) {

                        if (dt[i].isChecked) {

                            count++;

                            console.log(count - 1);
                            var idx = count - 1;

                            //formData.append("model[" + i + "].IdSugerido", _rowsData[i].IdSugerido);
                            //formData.append("model[" + i + "].Idsucursal", _rowsData[i].IdSucursal);
                            //formData.append("model[" + i + "].Autorizado", _rowsData[i].Autorizado);
                            //console.log(dt[i])

                            formData.append("model[" + idx + "].IdSugerido", dt[i].IdSugerido);
                            formData.append("model[" + idx + "].Idsucursal", dt[i].IdSucursal);
                            formData.append("model[" + idx + "].Autorizado", dt[i].isChecked);



                        } else {

                            count++;

                            console.log(count - 1);
                            var idx = count - 1;

                            console.log("check falso o indefinido");
                            formData.append("model[" + idx + "].IdSugerido", dt[i].IdSugerido);
                            formData.append("model[" + idx + "].Idsucursal", dt[i].IdSucursal);
                            formData.append("model[" + idx + "].Autorizado", false);

                        }
                    }

                    if (count == 0) {
                        swal('Mensaje', 'Nada para Autorizar', "warning");
                        return;
                    }

                    $.ajax({
                        type: "POST",
                        url: "/Sugerido/GuardarValidacionMontos",
                        processData: false,
                        contentType: false,
                        data: formData,
                        success: function (response) {
                            hideLoading();
                            if (response.Success) {

                                swal(response.Message, '', "success").then((value) => {
                                    $("#btnAplicar").show();
                                });
                            } else {
                                swal(response.Message, '', "error");
                            }
                        },
                        error: function (e) {
                            hideLoading();
                            swal("¡Error inesperado en la carga!", '', "error");
                        }
                    });
                }
            });
        }


        function AplicarSugerido() {

            swal({
                title: '¿Aplicar Sugerido?',
                text: "Se Aplicarán todos los montos validados",
                icon: "warning",
                buttons: {
                    cancel: "Cancelar",
                    catch: {
                        text: "Continuar",
                        value: true
                    }
                },
            }).then((resp) => {

                if (resp) {
                    showLoading();

                    $.ajax({
                    url: "@Url.Action("AplicarSugerido", "Sugerido")",
                    type: "POST",
                    dataType: "json",
                        data: { idsugerido: @ViewBag.IdSugerido},
                        success: function (data) {
                            hideLoading();

                            if (data.Success) {

                                swal("Sugerido Aplicado", '', "success").then((value) => {

                                    //window.location.href = '@Url.Action("OrdenesCompra", "OC",new { id_sugerido = @ViewBag.IdSugerido})'
                                    window.location.href = '@Url.Action("OrdenesCompra", "OC")'


                                });
                            } else {
                                swal("Error al aplicar el sugerido", '', "error");
                            }
                        },
                        error: function (response) {
                            hideLoading();
                                swal("Error al aplicar el sugerido", '', "error");
                        //    swal("Error al eliminar", '', "error: " + response);
                        }

                    });
                }
            });
            }

            function goDetalleSugerido() {
                window.location.href = "@Url.Action("ConsultaSugerido", "ValidaSugerido", new { @idsugerido = @ViewBag.IdSugerido })";
            }

            function goListaSugerido() {
                window.location.href = "@Url.Action("ListaSugerido", "Sugerido")";
            }

            function goOrdenesCompra() {
                window.location.href = "@Url.Action("OrdenesCompra", "OC")";
            }


    </script>
}

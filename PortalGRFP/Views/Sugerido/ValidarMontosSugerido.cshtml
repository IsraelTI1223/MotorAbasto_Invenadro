@{
    ViewBag.Title = "Validar Monto del Sugerido";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>Sugerido de Compra</a></li>
    <li class="breadcrumb-item"><a>Validar los Montos del Sugerido</a></li>
}

<div class="card" style="width:100%">
    <div class="card-header">
        <div style="text-align: left"><span>ID Sugerido: </span><span id="IdSugerido" style="color: #808080">@ViewBag.IdSugerido</span></div>
        <div style="text-align:right">
            <button style="display: none" class="btn btn-sm pd-x-15 btn-warning btn-lg" id="btnAplicar" onclick="AplicarSugerido()" title="Aplicar Sugerido">
                Aplicar Sugerido <i class="fa fa-arrow-circle-right" aria-hidden="true"></i>
            </button>
            <button class="btn btn-sm pd-x-15 btn-success btn-lg" id="btnValidar" onclick="validarPermisos()" title="Validar Montos">
                Autorizar Montos <i class="fa fa-check" aria-hidden="true"></i>
            </button>
            <br /><span id="spanTxt" style="color: red;display: none">Sin Cambios para guardar</span>
        </div>
        @*<div id="spanTxt" class="alert alert-warning alert-dismissible fade show" role="alert">
                <strong>Sin Cambios para guardar</strong>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>*@
    </div>
    <div class="card-body">
        <table id="tbSugerido" class="display compact cell-border" width="100%"></table>
    </div>

    <div class="card-footer">

        <div class="row">
            <div class="col-auto">
                <div style="text-align: left">
                    <button class="btn btn-sm pd-x-15 btn-primary" id="btnListaSugerido" onclick="goListaSugerido()" title="Ir a lista de sugerido">
                        Atras
                    </button>
                    <button class="btn btn-sm pd-x-15 btn-primary" id="btnOrdComp" onclick="goOrdenesCompra()" title="Ir a Ordenes de Compra">
                        Siguiente
                    </button>
                </div>
            </div>
            <div class="col-auto">
                <div style="text-align: right">
                    <button class="btn btn-sm pd-x-15 btn-info btn-lg" id="btnSugerido" onclick="goDetalleSugerido()" title="Ver Sugerido">
                        Consultar Sugerido
                    </button>
                </div>
            </div>
        </div>






    </div>
</div>

@section scripts{
    <script>

        var dtapi;
        var fillInDT = 0;

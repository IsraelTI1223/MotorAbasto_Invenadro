@using PortalGRFP.Entities.Common

@{
    PortalGRFP.Entities.Common.ProveedoresAgenciaFTPCompleto idUs = ViewBag.Cabecera;
    ViewBag.Title = "Editar Configuración FTP";
}

@*<p class="text-info"><hr class="hr-primary" /><a><h3>DATOS PERSONALES</h3></a><hr /></p>

    <br>*@
<br>
<br>

<form method="post" class="form-group col-md-12" id="frmModificaFTP">

    <div class="form-row">




        <div>
            <b>

                <label for="inputArea">Id: </label>
                @Html.TextBox("Id", @idUs.Id, new { @class = "form-control", @readonly = "true" })
            </b>
        </div>

        <div>
            <b>

                <label for="inputArea">Proveedor: </label>
                @Html.TextBox("Proveedor", @idUs.Proveedor, new { @class = "form-control", @readonly = "true" })
            </b>
        </div>

        <div>
            <b>

                <label for="inputArea">Agencia: </label>
                @Html.TextBox("Agencia", @idUs.Agencia, new { @class = "form-control", @readonly = "true" })
            </b>
        </div>
        <div>
            <b>

                <label for="inputArea">Tipo Formato: </label>
                @Html.TextBox("Tipo_Formato", @idUs.Tipo_Formato, new { @class = "form-control", @readonly = "true" })
                <br /><span id="spanTxtTipoForm" style="color: red;display: none">Tipo Formato es obligatorio</span>

            </b>
        </div>


    </div>

    <br>
    <br>
    <div class="form-row">


        <div class="form-group col-md-3">
            <b>


                <label for="inputState">URL:  </label>
                @Html.TextBox("URL", @idUs.URL, new { @class = "form-control" })

                @*<font name="id_Folio" color="red">@Html.DisplayFor(modelItem => @idUs.id_Folio)</font>*@
            </b>
        </div>


        <div class="form-group col-md-3">
            <b>


                <label for="inputState">Directorio:  </label>
                @Html.TextBox("Directorio", @idUs.Directorio, new { @class = "form-control" })

                @*<font name="id_Folio" color="red">@Html.DisplayFor(modelItem => @idUs.id_Folio)</font>*@
            </b>
        </div>

        <div class="form-group col-md-3">
            <b>


                <label for="inputState">Directorio_Respaldo:  </label>
                @Html.TextBox("Directorio_Respaldo", @idUs.Directorio_Respaldo, new { @class = "form-control" })

                @*<font name="id_Folio" color="red">@Html.DisplayFor(modelItem => @idUs.id_Folio)</font>*@
            </b>
        </div>

        <div class="form-group col-md-2">
            <input type="checkbox" id="check" onchange="habilitarbe(this.checked);" value="SI" name="Copia_Respaldo" checked>
            <label for="inputCopia"> Copia de respaldo </label>

        </div>

        <div class="form-group col-md-2">
            <input type="checkbox" id="check" onchange="habilitarbe(this.checked);" name="Elimina_Origen" value="SI" checked>
            <label for="inputEorigen"> Eliminar Origen </label>

        </div>



        <div class="form-group col-md-3">
            <label for="ddlProv">Tipo de Formato </label>
            <select id="ddlProv" min="1" class="form-control" name="Frecuencia" onchange="carg(this);">
                <option selected>Seleccionar...</option>
                @foreach (var item in TempData["Frecuencia"] as List<ComboGenerico>)
                {
                    <option value="@item.Id">@item.Valor</option>
                }
            </select>
        </div>


        <div class="form-group col-md-2">
            <label for="inputColonia">Tiempo de Referencia </label>
            <input type="time" class="form-control" id="TimepoR" name="Tiempo_Frecuencia" placeholder="Directorio de respaldo">
        </div>

        <div class="form-group col-md-3">
            <label for="inputColonia">Fecha proxima a ejecutar: </label>
            <input type="datetime-local" class="form-control" id="Fecha_Proxima_Ejecucion" name="Fecha_Proxima_Ejecucion" placeholder="Directorio de respaldo" required>
            <span id="msjFecha" style="color: red; display:none">Campo vacio</span>
        </div>

        <div class="form-group col-md-2">
            <label for="inputColonia">Hora Inicio </label>
            <input type="time" class="form-control" id="HoraI" name="Hora_Ini" placeholder="Directorio de respaldo" required>
        </div>

        <div class="form-group col-md-2">
            <label for="inputColonia">Hora Fin </label>
            <input type="time" class="form-control" id="HoraF" name="Hora_Fin" placeholder="Directorio de respaldo" required>
        </div>

        <div class="form-group col-md-3">
            <b>


                <label for="inputState">Usuario FTP:  </label>
                @Html.TextBox("Usuario_FTP", @idUs.Usuario_FTP, new { @class = "form-control", @required = "true" })

                @*<font name="id_Folio" color="red">@Html.DisplayFor(modelItem => @idUs.id_Folio)</font>*@
            </b>
        </div>

        <div class="form-group col-md-3">
            <b>


                <label for="inputState">Clave FTP:  </label>
                @Html.Password("Clave_FTP", @idUs.Clave_FTP, new { @class = "form-control", @required = "required" })

                @*<font name="id_Folio" color="red">@Html.DisplayFor(modelItem => @idUs.id_Folio)</font>*@
            </b>
        </div>

        <div class="form-group col-md-3">
            <b>


                <label for="inputState">Nomenclatura Archivo :  </label>
                @Html.TextBox("Nomenclatura_Archivo", @idUs.Nomenclatura_Archivo, new { @class = "form-control", @required = "required" })

                @*<font name="id_Folio" color="red">@Html.DisplayFor(modelItem => @idUs.id_Folio)</font>*@
            </b>
        </div>
    </div>
    <br>





    <br>
    <button type="submit" id="btnSumet" class="btn btn-primary">Modificar FTP</button>

</form>


<script>

    function prueba() {
        $("#frmModificaFTP").serializeArray().forEach(function (item) {
            console.log(item);
        });
    }

    function carg(elemento) {

        console.log(elemento)


        d = elemento.value;


        if (d == "2") {
            document.getElementById("TimepoR").disabled = false;
            document.getElementById("HoraI").disabled = false;
            document.getElementById("HoraF").disabled = false;
            $('#HoraI').val('');

           
        }

        else {
            document.getElementById("TimepoR").disabled = true;
            document.getElementById("HoraI").disabled = false;

            document.getElementById("HoraF").disabled = true;


            $('#TimepoR').val("");
            $('#HoraI').val("");
            $('#HoraF').val("");

        }
    }

    $(document).ready(function () {
          ObtenerAgencias();
        getDateNow();

            function ObtenerAgencias() {
                showLoading();
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("InformacionComplementariaSet", "ConfiguracionesProveedores")",
                    //data: datos,
                    dataType: "json",
                    processData: false,  // tell jQuery not to process the data
                    contentType: false,
                    success: function (response) {
                        hideLoading();
                        $("#ddlProv").val(response.Frecuencia);
                        $("#TimepoR").val(response.Tiempo_Frecuencia);
                        $("#Fecha_Proxima_Ejecucion").val(response.Fecha_Proxima_Ejecucion);
                        $("#HoraI").val(response.Hora_Ini);
                        $("#HoraF").val(response.Hora_Fin);



                        if (response.Frecuencia == "2") {
                            document.getElementById("TimepoR").disabled = false;
                            document.getElementById("HoraI").disabled = false;
                            document.getElementById("HoraF").disabled = false;

                           

                        }

                        else {
                            document.getElementById("TimepoR").disabled = true;
                            document.getElementById("HoraI").disabled = false;

                            document.getElementById("HoraF").disabled = true;

                         
                          
                         
                        }





                    },
                    error: function (response) {
                    }
                });
        }

       /* $("#btnSumet").on("click", function (event) {
            event.preventDefault();

            if ($("#Fecha_Proxima_Ejecucion").val()=="") {
                console.log("fecha vacio");

                $("#msjFecha").show();

                return;
            }
            swal({
                title: '',
                text: "¿Desea guardar los cambios?",
                icon: "warning",
                buttons: true,
                dangerMode: true,
            }).then((willDelete) => {
                if (willDelete != null) {
                    $("#frmModificaFTP").submit();
                }

            });
        });*/

        function getDateNow() {
            var f = new Date();
            //document.getElementById("Fecha_Proxima_Ejecucion").min = new Date(f.getTime() - f.getTimezoneOffset() * 60000).toISOString().substring(0, 19);

            var mes;
            var year;
            var dia;

            if ((f.getMonth() + 1) < 10) {
                mes = "0" + (f.getMonth() + 1)
            } else {
                mes = (f.getMonth() + 1)

            }
            if (f.getDate() < 10) {
                dia = "0" + f.getDate();
            } else {
                dia = f.getDate();
            }
            year = f.getFullYear();

            document.getElementById("Fecha_Proxima_Ejecucion").min = year + "-" + mes + "-" + dia + "T00:00:00";


        }




        $("#frmModificaFTP").submit(function (e) {
            e.preventDefault();


            //if (confirm("Vas Modificar información, ¿Seguro de continuar?")) {


            //    showLoading();


            var formData = new FormData();
            var Tipo_Formato;

                $("#frmModificaFTP").serializeArray().forEach(function (item) {
                    console.log(item.name + " " + item.value);

                    if (item.name == "Id") {
                        formData.append("Id", item.value);
                    }
                    if (item.name == "Proveedor") {
                        formData.append("Proveedor", item.value);
                    }
                    if (item.name == "Agencia") {
                        formData.append("Agencia", item.value);
                    }
                    if (item.name == "Tipo_Formato") {
                        formData.append("Tipo_Formato", item.value);
                        Tipo_Formato = item.value;
                    }
                    if (item.name == "URL") {
                        formData.append("URL", item.value);
                    }
                    if (item.name == "Directorio") {
                        formData.append("Directorio", item.value);
                    }
                    if (item.name == "Directorio_Respaldo") {
                        formData.append("Directorio_Respaldo", item.value);
                    }
                    if (item.name == "Copia_Respaldo") {
                        formData.append("Copia_Respaldo", item.value);
                    }
                    if (item.name == "Elimina_Origen") {
                        formData.append("Elimina_Origen", item.value);
                    }
                    if (item.name == "Frecuencia") {
                        formData.append("Frecuencia", item.value);
                    }
                    if (item.name == "Fecha_Proxima_Ejecucion") {
                        formData.append("Fecha_Proxima_Ejecucion", item.value);
                    }
                    if (item.name == "Hora_Ini") {
                        formData.append("Hora_Ini", item.value);
                    }
                    if (item.name == "Hora_Fin") {
                        formData.append("Hora_Fin", item.value);
                    }
                    if (item.name == "Usuario_FTP") {
                        formData.append("Usuario_FTP", item.value);
                    }
                    if (item.name == "Clave_FTP") {
                        formData.append("Clave_FTP", item.value);
                    }
                    if (item.name == "Nomenclatura_Archivo") {
                        formData.append("Nomenclatura_Archivo", item.value);
                    }
                    if (item.name == "Tiempo_Frecuencia") {
                        formData.append("Tiempo_Frecuencia", item.value);
                    }


                });
            if (Tipo_Formato == 'Seleccionar...' || Tipo_Formato == undefined) {
                $('#spanTxtTipoForm').show();
                return;
            } else {
                $('#spanTxtTipoForm').hide();
            }



                if (confirm("Vas Modificar información, ¿Seguro de continuar?")) {


                    showLoading();

                $.ajax({
                    url: "/ConfiguracionesProveedores/ModificarFTP",
                    type: 'POST',
                    cache: false,
                    contentType: false,
                    processData: false,
                    data: formData,

                    success: function (response) {
                        hideLoading();

                        if (response == 'ok') {

                            swal('Exito al Guardar', '', "success").then((value) => {
                               document.location.href = "@Url.Content("~/ConfiguracionesProveedores/Ftp")";
                            });
                        } else {
                            swal('Error al Guardar', '', "error");
                        }
                    },
                    error: function (e) {
                        hideLoading();
                        swal('Error al guardar', '', "error");
                    }
                });

            }

        });
    });

</script>
@model PortalGRFP.Entities.Response.ResponseList<PortalGRFP.Entities.Common.ConfiguracionCarga>
@{
    ViewBag.Title = "Configuración de carga";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>CONFIGURACIÓN MODULOS</a></li>
    <li class="breadcrumb-item"><a>CARGA PMP & DESCUENTOS</a></li>
}

@section Actions{

}

<div class="col-lg-12">
    <div class="row">
        <div class="table-responsive">
            <table class="table table-striped" id="tFileUploadConfiguration">
                <thead class="thead-primary">
                    <tr>
                        <th>&nbsp;</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Archivos por día</th>
                        <th scope="col">Hora Inicio</th>
                        <th scope="col">Hora Fin</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Success)
                    {
                        foreach (var d in Model.Result)
                        {
                            <tr>
                                <td>&nbsp;</td>
                                <td>@d.Tipo</td>
                                <td>@d.Nombre</td>
                                <td>@d.ArchivosPorDia</td>
                                <td>@d.HoraInicio</td>
                                <td>@d.HoraFin</td>
                                <td>
                                    <a class="editConfiguration" style="cursor:pointer" data-idCarga="@d.IdCarga" data-archivos-por-dia="@d.ArchivosPorDia" data-hora-inicio="@d.HoraInicio" data-hora-fin="@d.HoraFin">
                                        <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-pencil-square" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456l-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                                            <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5v11z" />
                                        </svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="editConfigurationModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">Editar cofiguración de carga</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnIdCarga" />
                <div class="form-group">
                    <label id="lblFileName" class="control-label" for="customFile">Archivos por día</label>
                    <input type="number" class="form-control" id="txtArchivosXDia" min="1">
                </div>
                <div class="form-group">
                    <label class="control-label" for="customFile">Hora inicio</label>
                    <input type="time" class="form-control" id="txtHoraInicio">
                </div>
                <div class="form-group">
                    <label class="control-label" for="customFile">Hora fin</label>
                    <input type="time" class="form-control" id="txtHoraFin">
                </div>
                <div class="form-group">
                    <div id="feedback" class="invalid-feedback" style="display:block"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnEditFileUploadConfiguration">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script type="text/javascript" src="~/Scripts/App/Views/fileUpLoadConfiguration.js"></script>
}
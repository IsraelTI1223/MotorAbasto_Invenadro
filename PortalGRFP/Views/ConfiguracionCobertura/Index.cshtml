@model PortalGRFP.Entities.Common.CoberturaMontoPza
@using PortalGRFP.Entities.Common
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>Configuraciones</a></li>
    <li class="breadcrumb-item"><a>Generales</a></li>
    <li class="breadcrumb-item"><a>Catálogos de Cobertura> </a></li>
    <li class="breadcrumb-item"><a>Montos / Piezas </a></li>
}
<div class="container-fluid">
    @* <div class="row">*@
    <div class="card">
        <div class="card-header">
            @using (Html.BeginForm("AgregarCobertura", "ConfiguracionCobertura", FormMethod.Post, new { role = "form", id = "frmCobertura" }))
            {
                @*@Html.ValidationSummary(true, "", new { @class = "text-danger" })*@
                @*<div class="form-inline">*@
                <div class="form-group row">
                    <div class="col-xs-3 col-md-2">
                        <label class="control-label">Forma</label>agregar
                        <select id="forma" name="forma" class="form-control">
                            <option value="0">Seleccione</option>
                            @foreach (var item in TempData["Formas"] as List<CatalogoGenerico_Conf>)
                            {
                                <option value="@item.Id_Catalogo">@item.Valor_Catalogo</option>
                            }
                        </select>
                    </div>
                    <div class="col-xs-3 col-md-2">
                        @Html.LabelFor(model => model.Tipo, htmlAttributes: new { @class = "control-label" })

                        <select id="Tipo" name="Tipo" class="form-control">
                            <option value="0">Seleccione</option>
                            @foreach (var item in TempData["Tipos"] as List<CatalogoGenerico_Conf>)
                            {
                                <option value="@item.Id_Catalogo">@item.Valor_Catalogo</option>
                            }
                        </select>

                    </div>
                    <div class="col-xs-3 col-md-2" data-group="montos" style="display:none">
                        <label class="control-label">ABC</label>
                        <select id="ClasficacionMonto" name="ClasficacionMonto" class="form-control">
                            <option value="0">Seleccione</option>
                            @foreach (var item in TempData["Clasificaciones"] as List<CatalogoGenerico_Conf>)
                            {
                                <option value="@item.Id_Catalogo">@item.Valor_Catalogo</option>
                            }
                        </select>

                    </div>
                    <div class="col-xs-3 col-md-2" data-group="montos" style="display:none">
                        <label class="control-label" id="MontosPorcentaje"></label>
                        <div class="text-right">
                            <label class="control-label float-left">De&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</label>
                            @Html.EditorFor(model => model.MontoDe, new { htmlAttributes = new { placeholder = "0.0000", @class = "form-control w-50", type = "number", min = 0, step = "0.0001", oninput = "validity.valid||(value='')" } })
                        </div>
                        <div class="text-right">
                            <label class="control-label float-left"> Hasta</label>
                            @Html.EditorFor(model => model.MontoHasta, new { htmlAttributes = new { placeholder = "0.0000", @class = "form-control w-50", type = "number", min = 0, step = "0.0001", oninput = "validity.valid||(value='')" } })
                        </div>

                    </div>
                    <div class="col-xs-3 col-md-2" data-group="piezas" style="display:none">
                        <label class="control-label">ABC</label>
                        <select id="ClasficacionPieza" name="ClasficacionPieza" class="form-control">
                            <option value="0">Seleccione</option>
                            @foreach (var item in TempData["Clasificaciones"] as List<CatalogoGenerico_Conf>)
                            {
                                <option value="@item.Id_Catalogo">@item.Valor_Catalogo</option>
                            }
                        </select>
                    </div>
                    <div class="col-xs-3 col-md-2" data-group="piezas" style="display:none">
                        <label class="control-label" id="PiezasPorcentaje"></label>
                        <div class="text-right">
                            <label class="control-label float-left">De&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</label>
                            @Html.EditorFor(model => model.PiezasDe, new { htmlAttributes = new { placeholder = "0", @class = "form-control w-50", type = "number", min = 0, oninput = "validity.valid||(value='')" } })
                        </div>
                        <div class="text-right">
                            <label class="control-label float-left">Hasta</label>
                            @Html.EditorFor(model => model.PiezasHasta, new { htmlAttributes = new { placeholder = "0", @class = "form-control w-50", type = "number", min = 0, oninput = "validity.valid||(value='')" } })
                        </div>
                    </div>
                    <div class="col-xs-3 col-md-2" data-group="porcentaje" style="display:none">
                        <div class="text-md-left checkbox form-inline">
                            <label class="control-label">
                                % Participación
                                por Grupo &nbsp;&nbsp;
                                <input class="check-box form-check-input" data-val="true" id="ParticipacionGrupo" name="ParticipacionGrupo" type="checkbox" value="true">
                            </label>
                        </div>
                        <div class="text-md-left checkbox form-inline">
                            <label class="control-label">
                                % Participación
                                por División  &nbsp;&nbsp;
                                <input class="check-box form-check-input" data-val="true" id="ParticipacionDivision" name="ParticipacionDivision" type="checkbox" value="true">
                            </label>
                        </div>
                    </div>
                    <div class="col-xs-3 col-md-2" data-group="diasInv" style="display:none">
                        <label class="control-label">Días de Inventario</label>
                        <label class="control-label"> por tipo de proveedor</label>
                        <div class="text-left form-inline">
                            @Html.EditorFor(model => model.DiasCoberturaMay, new { htmlAttributes = new { placeholder = "0", @class = "form-control", style = "width:50px", min = 0, oninput = "validity.valid||(value='')" } })
                            <label class="control-label float-md-left">Mayorista</label>
                        </div>
                        <div class="text-left form-inline">
                            @Html.EditorFor(model => model.DiasCoberturaCed, new { htmlAttributes = new { placeholder = "0", @class = "form-control", style = "width:50px", min = 0, oninput = "validity.valid||(value='')" } })
                            <label class="control-label float-md-left">Cedis</label>
                        </div>
                        <div class="text-left form-inline">
                            @Html.EditorFor(model => model.DiasCoberturaPieCam, new { htmlAttributes = new { placeholder = "0", @class = "form-control", style = "width:50px", min = 0, oninput = "validity.valid||(value='')" } })
                            <label class="control-label float-md-left">Pie de Camión</label>
                        </div>
                    </div>
                    <div class="col-xs-3 col-md-2 text-center" data-group="frec" style="display:none">
                        <label class="control-label">Frecuencia</label>
                        <label class="control-label">de Actualización</label>
                        <select id="Periodicidad" name="Periodicidad" class="form-control">
                            <option value="0">Seleccione</option>
                            @foreach (var item in TempData["Periodicidad"] as List<CatalogoGenerico_Conf>)
                            {
                                <option value="@item.Id_Catalogo">@item.Valor_Catalogo</option>
                            }
                        </select>

                    </div>
                    <div class="col-sm-3 col-md-2">
                        <div class="btn-group">
                            <input type="button" value="Consultar" id="btnConsultar" name="btnConsultar" class="btn btn-warning" />
                            <input type="submit" value="Agregar" class="btn btn-primary" />
                        </div>
                    </div>
                </div>
                @*</div>*@
            }
        </div>

        <div class="card-body w-100">
            <table id="tblCobertura" class="display compact cell-border" width="100%"></table>
        </div>
    </div>
    @*</div>*@
</div>


                        $('div[data-group="montos"]').css("display", "block");
                        $('div[data-group="piezas"]').css("display", "block");
                    }
                    if ($("#forma").val() == "2") {
                        $('div[data-group="porcentaje"]').css("display", "block");
                        $('#MontosPorcentaje').text("Rango Montos %");
                        $('#PiezasPorcentaje').text("Rango de Piezas %");
                    } else {
                        $('div[data-group="porcentaje"]').css("display", "none");
                        $('#MontosPorcentaje').text("Rango Montos");
                        $('#PiezasPorcentaje').text("Rango de Piezas");
                    }
                    $('div[data-group="diasInv"]').css("display", "block");
                    $('div[data-group="frec"]').css("display", "block");


                } else {
                    $("#Tipo").val("0");
                    swal("Seleccione una forma", '', "warning");
                }
            });


                    $.ajax({
                     url: "@Url.Action("ValidarForma", "ConfiguracionCobertura")",
                type: "POST",
                dataType: "json",
                        data: { IdForma: String($("#forma").val()) },
                    success: function (response) {

                        //console.log(response)

                        if (response.Message != String($("#forma").val())) {
                            swal({
                                title: 'Cambio de Forma',
                                text: "La forma seleccionada es diferente a la forma ya configurada, si continua con el guardado se eliminará toda la configuración de la forma existente ¿Desea continuar de todos modos?",
                                icon: "warning",
                                buttons: true,
                                dangerMode: true,
                            }).then((confirmResult) => {

                                if (confirmResult) {

                                    CambioForma();
                                    //guardarCobertura();
                                }

                            });
                        } else {
                            guardarCobertura();
                        }

                    },
                    error: function (response) {
                        hideLoading();
                    }
                });
                    //swal({
                    //    title: '',
                    //    text: "¿Desea guardar los cambios?",
                    //    icon: "warning",
                    //    buttons: true,
                    //    dangerMode: true,
                    //}).then((willDelete) => {

                    //    if (willDelete != null) {
                    //        var regla = $("#frmCobertura").serializeArray()
                    //            .filter(function (elem) {
                    //                return $.trim(elem.value);
                    //            });

                    //        showLoading();
                    //        $.ajax({
                    //            type: $("#frmCobertura").attr('method'),
                    //            url: $("#frmCobertura").attr('action'),
                    //            data: regla,
                    //            success: function (response) {
                    //                hideLoading();
                    //                swal(response.Message, '', "success")
                    //                    .then((value) => {
                    //                        $("#btnConsultar").trigger("click");
                    //                    });
                    //            },
                    //            error: function (response) {
                    //                swal(response.Message, '', "warning");
                    //            }
                    //        });
                    //    }
                    //});
                }
            });
            function CambioForma() {
                 $.ajax({
                     url: "@Url.Action("EliminarCambioForma", "ConfiguracionCobertura")",
                type: "POST",
                dataType: "json",
                        data: { IdForma: String($("#forma").val()) },
                     success: function (response) {
                         if (response.Success) {

                             swal("Cambio de forma", 'Se Aplicó el cambio de forma', "success").then((value) => {
                                 guardarCobertura();
                             });
                            


                         } else {
                             swall("Error", "Ocurrió un Error al cambiar la forma, intente de nuevo", "error");
                         }

                     },
                     error: function (response) {
                         hideLoading();
                        
                     }
                 });
            }

            function guardarCobertura(){
                swal({
                    title: '',
                    text: "¿Desea guardar los cambios?",
                    icon: "warning",
                    buttons: true,
                    dangerMode: true,
                }).then((willDelete) => {

                    if (willDelete != null) {
                        var regla = $("#frmCobertura").serializeArray()
                            .filter(function (elem) {
                                return $.trim(elem.value);
                            });

                        showLoading();
                        $.ajax({
                            type: $("#frmCobertura").attr('method'),
                            url: $("#frmCobertura").attr('action'),
                            data: regla,
                            success: function (response) {
                                hideLoading();
                                swal(response.Message, '', "success")
                                    .then((value) => {
                                        $("#btnConsultar").trigger("click");
                                    });
                            },
                            error: function (response) {
                                swal(response.Message, '', "warning");
                            }
                        });
                    }
                });
            }


            function ValidacionForm() {

                var forma, tipo, clasificacionMonto, montod, montoh, clasificacionpza, pzad, pzah, porc_grupo, porc_division, diasm, diasc, diapc, frecuencia;
                var avanza = false;
                forma = $("#forma").val();
                tipo = $("#Tipo").val();
                clasificacionMonto = $("#ClasficacionMonto").val();
                montod = $("#MontoDe").val();
                montoh = $("#MontoHasta").val();
                clasificacionpza = $("#ClasficacionPieza").val();
                pzad = $("#PiezasDe").val();
                pzah = $("#PiezasHasta").val();
                porc_grupo = $("#ParticipacionGrupo").val();
                porc_division = $("#ParticipacionDivision").val();
                diasm = $("#DiasCoberturaMay").val();
                diasc = $("#DiasCoberturaCed").val();
                diapc = $("#DiasCoberturaPieCam").val();
                frecuencia = $("#Periodicidad").val();

                if (forma == "0")
                {
                    swal("seleccione una forma", '', "warning");
                } else if (forma == "1")
                {
                    if (tipo == "0") {
                        swal("seleccione un tipo", '', "warning");
                    } else if (tipo == "1") {
                        if (clasificacionMonto == "0") {
                            swal("seleccione una clasificación de monto", '', "warning");
                        } else {
                            if (montod == "" || montoh == "") {
                                swal("No se asignado el rango de montos", '', "warning");
                            } else if (parseInt(montoh) < parseInt(montod)) {
                                swal("Montos min y max incorrectos", '', "warning");
                            }
                            else {
                                if (diasm == "" && diasc == "" && diapc == "") {
                                    swal("No se asignado el días de inventario", '', "warning");
                                } else {
                                    if (frecuencia == "0") {
                                        swal("No ha seleccionado la frecuencia", '', "warning");
                                    } else {
                                        avanza = true;
                                    }
                                }
                            }

                        }
                    }
                    else if (tipo == "2") {
                        if (clasificacionpza == "0") {
                            swal("seleccione una clasificación de piezas", '', "warning");
                        } else {
                            if (pzad == "" || pzah == "") {
                                swal("No se asignado el rango de piezas", '', "warning");
                            } else if (parseInt(pzah) < parseInt(pzad)) {
                                swal("piezas min y max incorrectas", '', "warning");
                            } else {
                                if (diasm == "" && diasc == "" && diapc == "") {
                                    swal("No se asignado el días de inventario", '', "warning");
                                } else {
                                    if (frecuencia == "0") {
                                        swal("No ha seleccionado la frecuencia", '', "warning");
                                    } else {
                                        avanza = true;
                                    }
                                }
                            }
                        }
                    }
                    else if (tipo == "3") {
                        if (clasificacionMonto == "0") {
                            swal("seleccione una clasificación de monto", '', "warning");
                        } else {
                            if (montod == "" || montoh == "") {
                                swal("No se asignado el rango de montos", '', "warning");
                            } else if (parseInt(montoh) < parseInt(montod)) {
                                swal("Montos min y max incorrectos", '', "warning");
                            } else {
                                if (clasificacionpza == "0") {
                                    swal("seleccione una clasificación de piezas", '', "warning");
                                } else {
                                    if (pzad == "" || pzah == "") {
                                        swal("No se asignado el rango de piezas", '', "warning");
                                    } else if (parseInt(pzah) < parseInt(pzad)) {
                                        swal("piezas min y max incorrectas", '', "warning");
                                    } else {
                                        if (diasm == "" && diasc == "" && diapc == "") {
                                            swal("No se asignado el días de inventario", '', "warning");
                                        } else {
                                            if (frecuencia == "0") {
                                                swal("No ha seleccionado la frecuencia", '', "warning");
                                            } else {
                                                avanza = true;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                else if (forma == "2") {
                    if (tipo == "0") {
                        swal("seleccione un tipo", '', "warning");
                    } else if (tipo == "1") {
                        if (clasificacionMonto == "0") {
                            swal("seleccione una clasificación de monto", '', "warning");
                        } else {
                            if (montod == "" || montoh == "") {
                                swal("No se asignado el rango de montos", '', "warning");
                            } else {
                                if (parseInt(montod) > 100 || parseInt(montoh) > 100) {
                                    swal("Ha excedido el porcentaje en monto ", '', "warning");
                                } else if (parseInt(montoh) < parseInt(montod)) {
                                    swal("Montos min y max incorrectos", '', "warning");
                                } else {
                                    if (diasm == "" && diasc == "" && diapc == "") {
                                        swal("No se asignado el días de inventario", '', "warning");
                                    } else {
                                        if (frecuencia == "0") {
                                            swal("No ha seleccionado la frecuencia", '', "warning");
                                        } else {
                                            avanza = true;
                                        }
                                    }
                                }
                            }
                        }
                    } else if (tipo == "2") {
                        if (clasificacionpza == "0") {
                            swal("seleccione una clasificación de piezas", '', "warning");
                        } else {
                            if (pzad == "" || pzah == "") {
                                swal("No se asignado el rango de piezas", '', "warning");
                            } else {
                                if (parseInt(pzad) > 100 || parseInt(pzah) > 100) {
                                    swal("Ha excedido el porcentaje en piezas ", '', "warning");
                                } else if (parseInt(pzah) < parseInt(pzad)) {
                                    swal("piezas min y max incorrectas", '', "warning");
                                }else {
                                    if (diasm == "" && diasc == "" && diapc == "") {
                                        swal("No se asignado el días de inventario", '', "warning");
                                    } else {
                                        if (frecuencia == "0") {
                                            swal("No ha seleccionado la frecuencia", '', "warning");
                                        } else {
                                            avanza = true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    else if (tipo == "3") {
                        if (clasificacionMonto == "0") {
                            swal("seleccione una clasificación de monto", '', "warning");
                        } else {
                            if (montod == "" || montoh == "") {
                                swal("No se asignado el rango de montos", '', "warning");
                            } else {
                                if (parseInt(montod) > 100 || parseInt(montoh) > 100) {
                                    swal("Ha excedido el porcentaje en monto ", '', "warning");
                                } else if (parseInt(montoh) < parseInt(montod)) {
                                    swal("Montos min y max incorrectos", '', "warning");
                                } else {
                                    if (clasificacionpza == "0") {
                                        swal("seleccione una clasificación de piezas", '', "warning");
                                    } else {
                                        if (pzad == "" || pzah == "") {
                                            swal("No se asignado el rango de piezas", '', "warning");
                                        } else {
                                            if (parseInt(pzad) > 100 || parseInt(pzah) > 100) {
                                                swal("Ha excedido el porcentaje en monto ", '', "warning");
                                            } else if (parseInt(pzah) < parseInt(pzad)) {
                                                swal("piezas min y max incorrectas", '', "warning");
                                            }else {
                                                if (diasm == "" && diasc == "" && diapc == "") {
                                                    swal("No se asignado el días de inventario", '', "warning");
                                                } else {
                                                    if (frecuencia == "0") {
                                                        swal("No ha seleccionado la frecuencia", '', "warning");
                                                    } else {
                                                        avanza = true;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                return avanza;
            }

            $("#btnConsultar").click(function () {
                if (ValidacionBusqueda()) {
                    var regla = $("#frmCobertura").serializeArray()
                        .filter(function (elem) {
                            return $.trim(elem.value);
                        });
                    forma = $("#forma").val();
                    tipo = $("#Tipo").val();

                    showLoading();
                    $.ajax({
                        type: "Post",
                        url: "/ConfiguracionCobertura/ConsultarCobertura",
                        dataType: "json",
                        data: regla,
                        success: function (response) {
                            hideLoading();
                            if (response.Success) {
                                showCobertura(response.Result);

                            } else {
                                swal(response.Message, '', "error").then((value) => {
                                    showCobertura(response.Result);
                                });
                            }
                        },
                        error: function (response) {
                            hideLoading();
                            swal(response.Message, '', "warning");
                        }
                    });
                }
            });

            function ValidacionBusqueda() {

                var forma, tipo, clasificacionMonto, montod, montoh, clasificacionpza, pzad, pzah, porc_grupo, porc_division, diasm, diasc, diapc, frecuencia;
                var avanza = false;
                forma = $("#forma").val();
                tipo = $("#Tipo").val();
                clasificacionMonto = $("#ClasficacionMonto").val();
                clasificacionpza = $("#ClasficacionPieza").val();


                if (forma == "0") {
                    swal("seleccione una forma", '', "warning");
                } else {
                    if (tipo == "0") {
                        swal("seleccione un tipo", '', "warning");
                    } else if (tipo == "1") {
                        if (clasificacionMonto == "0") {
                            swal("seleccione una clasificación de monto", '', "warning");
                        } else {
                            avanza = true;
                        }
                    } else if (tipo == "2") {
                        if (clasificacionpza == "0") {
                            swal("seleccione una clasificación de piezas", '', "warning");
                        } else {
                            avanza = true;
                        }
                    }
                    else if (tipo == "3") {
                        if (clasificacionMonto == "0") {
                            swal("seleccione una clasificación de monto", '', "warning");
                        } else {
                            if (clasificacionpza == "0") {
                                swal("seleccione una clasificación de piezas", '', "warning");
                            } else {
                                avanza = true;
                            }
                        }
                    }
                }
                return avanza;
            }


            function showCobertura(dataRes) {
                tblCobertura.destroy();
                if ($("#forma").val() == "1") {
                    if ($("#Tipo").val() == "1")//montos
                    {
                        tblCobertura = $('#tblCobertura').DataTable({
                            data: dataRes,
                            "destroy": true,
                            "processing": true,
                            dom: 'Bfrtip',
                            columns: [
                                { data: "LetraMonto", title: 'Clasificación Monto' },
                                { data: "MontoDe", title: "De" },
                                { data: "MontoHasta", title: "Hasta" },
                                { data: "LetraPza", title: 'Clasificación Pieza', visible: false },
                                { data: "PiezasDe", title: "De", visible: false },
                                { data: "PiezasHasta", title: "Hasta", visible: false },
                                { data: "DiasCoberturaMay", title: "Días cobertura Mayorista" },
                                { data: "DiasCoberturaCed", title: 'Días Cobertura Cedis' },
                                { data: "DiasCoberturaPieCam", title: 'Días Cobertura Pie Camión' },
                                {
                                    data: null,
                                    title: 'Eliminar',

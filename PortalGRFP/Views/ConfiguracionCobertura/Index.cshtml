            tblCobertura.on('select', function (e, dt, type, indexes) {
                var rowData = tblCobertura.rows(['.selected']).data().toArray();

                $("#forma").val(rowData[0].Forma);
                $("#Tipo").val(rowData[0].Tipo);
                if ($("#Tipo").val() == "1")//montos
                {
                    $("#ClasficacionMonto").val(rowData[0].ClasficacionMonto);
                    $("#MontoDe").val(rowData[0].MontoDe);
                    $("#MontoHasta").val(rowData[0].MontoHasta);
                } else if ($("#Tipo").val() == "2")//piezas
                {
                    $("#ClasficacionPieza").val(rowData[0].ClasficacionPieza);
                    $("#PiezasDe").val(rowData[0].PiezasDe);
                    $("#PiezasHasta").val(rowData[0].PiezasHasta);
                }
                else if ($("#Tipo").val() == "3")//piezas
                {
                    $("#ClasficacionMonto").val(rowData[0].ClasficacionMonto);
                    $("#MontoDe").val(rowData[0].MontoDe);
                    $("#MontoHasta").val(rowData[0].MontoHasta);
                    $("#ClasficacionPieza").val(rowData[0].ClasficacionPieza);
                    $("#PiezasDe").val(rowData[0].PiezasDe);
                    $("#PiezasHasta").val(rowData[0].PiezasHasta);
                }
                if ($("#forma").val() == "2") {
                    if (rowData[0].ParticipacionGrupo) {
                        $("#ParticipacionGrupo").val(rowData[0].ParticipacionGrupo);
                        $("#ParticipacionGrupo").prop("checked", true);
                    }

                    if (rowData[0].ParticipacionDivision) {
                        $("#ParticipacionDivision").val(rowData[0].ParticipacionDivision);
                        $("#ParticipacionDivision").prop("checked", true);
                    }
                }

                $("#DiasCoberturaMay").val(rowData[0].DiasCoberturaMay);
                $("#DiasCoberturaCed").val(rowData[0].DiasCoberturaCed);
                $("#DiasCoberturaPieCam").val(rowData[0].DiasCoberturaPieCam);

                $("#Periodicidad").val(rowData[0].Periodicidad);

            }).on('deselect', function (e, dt, type, indexes) {
                $("#frmCobertura").trigger("reset");
            });

            $("#Tipo").change(function () {
                if ($("#forma").val() != "0") {
                    if ($("#Tipo").val() == "1")//Montos
                    {
                        $('div[data-group="montos"]').css("display", "block");
                        $('div[data-group="piezas"]').css("display", "none");
                    } else if ($("#Tipo").val() == "2")//piezas
                    {
                        $('div[data-group="montos"]').css("display", "none");
                        $('div[data-group="piezas"]').css("display", "block");
                    } else if ($("#Tipo").val() == "3")//piezas

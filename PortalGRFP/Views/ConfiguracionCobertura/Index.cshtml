        function Eliminar(idForma, IdTipo, IdClasificacionMonto, IdClasificacioPza) {
            swal({
                title: 'Eliminar Cobertura',
                text: "¿Seguro de Eliminar la cobertura seleccionada?",
                icon: "warning",
                buttons: {
                    cancel: "Cancelar",
                    catch: {
                        text: "Eliminar",
                        value: true
                    }
                },
            }).then((resp) => {
                if (resp) {
                    showLoading();
                    var llavesCob = new FormData();
                    llavesCob.append("forma", idForma);
                    llavesCob.append("tipo", IdTipo);
                    llavesCob.append("ClasifMonto", IdClasificacionMonto);
                    llavesCob.append("ClasifPza", IdClasificacioPza);
                    var param = 'f=' + idForma + '&t=' + IdTipo + '&m=' + IdClasificacionMonto + '&p=' + IdClasificacioPza;

                    var xhttp = new XMLHttpRequest();
                    xhttp.onreadystatechange = function () {
                        if (this.readyState == 4 && this.status == 200) {
                            hideLoading();
                            var myObj = JSON.parse(this.response);
                            swal('',myObj.Message , "success").then((value) => {
                                window.location.href = "/ConfiguracionCobertura/Index";
                            });
                        } else {
                            hideLoading();
                            var myObj = JSON.parse(this.response);
                            swal('', myObj.Message,  "warning");
                        }
                    };
                    xhttp.open("POST", '/ConfiguracionCobertura/EliminarCobertura?' + param, true);
                    xhttp.send();


                    @*$.ajax({
                    url: '@Url.Action("EliminarCobertura", "ConfiguracionCobertura")',
                    type: "POST",
                    dataType: "json",
                        data: llavesCob,
                        success: function (response) {
                            hideLoading();
                            tblCobertura.destroy();
                            $("#frmCobertura").trigger("reset");
                            swal('', response.Message, "Success");
                        },
                        error: function (response) {
                            hideLoading();
                            swal('', response.Message, "warning");
                        }

                    });*@
                }
            });
        }


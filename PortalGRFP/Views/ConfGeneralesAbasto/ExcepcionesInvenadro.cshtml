@using PortalGRFP.Entities.Common


@{
    ViewBag.Title = "Excepciones Invenadro";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="anchor" id="formComplex"></span>
@section Breadcrumbs{
    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Home</a></li>
    <li class="breadcrumb-item"><a>Configuración</a></li>
    <li class="breadcrumb-item"><a>Excepciones Invenadro</a></li>
}

<div class="col-sm-12">
    <div class="card mb-12">
        <form id="frm">
            <div class="row g-0">
                <div class="card-body">
                    <div class="row" style="margin-left:5px">
                        <div class="col-md-4">
                            <label for="FechaInicial" class="form-label">Fecha Inicio:</label>
                            <input type="date" name="FechaInicial" class="form-control" id="FechaInicial" placeholder="dd/mm/aaaa" />
                        </div>
                        <div class="col-md-4">
                            <label for="FechaFinal" class="form-label">Fecha Fin:</label>
                            <input type="date" name="FechaFinal" class="form-control" id="FechaFinal" placeholder="dd/mm/aaaa" />
                        </div>
                        <div class="col-md-3">
                            <br />
                            <div class="btn-group">
                                <div style="text-align:right; margin-left:250%">
                                    <button id="btnCargar" type="button" class="btn btn-primary mb-3"> Guardar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>


@section scripts{
    <script>
        $(document).ready(function () {

            //var Fecha = new Date();
            //var mes; var dia;
            //var FechaIniMin1; 
            //var FechaIniMin; 

            //if ((Fecha.getMonth()) < 10) { mes = "0" + (Fecha.getMonth()) } else { mes = (Fecha.getMonth()) }
            //if (Fecha.getDate() < 10) { dia = "0" + Fecha.getDate() } else { dia = Fecha.getDate(); }

            //FechaIniMin1 = new Date(Fecha.getFullYear(), (mes), (dia));

            //if ((FechaIniMin1.getMonth()) < 10) { ('0' + FechaIniMin1.getMonth() + 1) } else { mes = (FechaIniMin1.getMonth() + 1) }

            //FechaIniMin = (FechaIniMin1.getFullYear() + "-" + mes + "-" + dia).toString();
            //console.log("Fecha inicio minima = " + FechaIniMin)


            $("#FechaInicial").on("change", function () {
                if ($("#FechaFinal").val() != "") {
                    if ($("#FechaInicial").val() > $("#FechaFinal").val()) {

                        swal("Error", "La fecha inicial no puede ser mayor a la final", "warning");

                        $("#FechaInicial").val("");
                        $("#FechaFinal").val("");
                    }
                }
            });

            $("#FechaFinal").on("change", function () {
                if ($("#FechaInicial").val() > $("#FechaFinal").val()) {

                    swal("Error", "La fecha inicial no puede ser mayor a la final", "warning");

                    $("#FechaInicial").val("");
                    $("#FechaFinal").val("");
                }
            });


            $("#btnCargar").click(function () {

               CargaExcep();

            });

           
            function CargaExcep() {

               var formulario = document.getElementById('frm');
               var formData = new FormData(formulario);

               showLoading();
               $.ajax({
                 type: "POST",
                 url: "@Url.Action("CargaExcepcionesInvenadro", "ConfGeneralesAbasto")",
                 processData: false,
                 contentType: false,
                   data: formData,
                   success: function (response) {
                       if (response.Success) {

                           swal(response.Message, '', "success").then((value) => {
                               location.reload();
                               Reset();
                           });
                       } else {
                           swal(response.Message, '', "error");
                       }
                       hideLoading();
               },
                   error: function (response) {
                       hideLoading();
                       swal(response.Message, '', "warning");
                   }
               });
       
            }
        });

    </script>
}



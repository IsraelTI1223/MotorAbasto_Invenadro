@using PortalGRFP.Entities.Common.Capacity

@{
    ViewBag.Title = "Configuración de Capacity";
}
@{
    var lstMarca = TempData["lstMarca"] as cCapacity;

}
@section Breadcrumbs{
    <li class="breadcrumb-item active"><a>Configuraciones</a></li>
    <li class="breadcrumb-item"><a>Generales</a></li>
    <li class="breadcrumb-item"><a>Capacity</a></li>
}
<div class="container">
    <ul class="nav nav-tabs" id="myTab">
        <li class="nav-item"><a class="nav-link active" href="#CAPACITY" data-toggle="tab">CAPACITY</a></li>
        <li class="nav-item"><a class="nav-link" href="#CONFIGCAPACITY" data-toggle="tab">CONFIGURACIÓN DEL CAPACITY</a></li>
    </ul>
    <dsiv class="tab-content my-tab">
        <div class="tab-pane active" id="CAPACITY">
            <div class="card" id="card_compra" style="width:100%">
                <div class="card-header">
                    <h5>Carga Manual</h5>
                    <form id="FrmCapacity">
                        <div class="row">
                            <div class="col-md-4" id="Combo">
                                Seleccione Marca/Sucursales
                                <select id="Marca" name="Marca" multiple="multiple" class="form-control col-md-10">
                                    @{
                                        foreach (var lista in lstMarca.comboCapacity)
                                        {
                                            <option value="@lista.Value"> @lista.Descripcion</option>
                                        }
                                    }

                                </select>
                            </div>
                            <div class="col-md-5">
                                Acción a Ejecutar
                                <div class="form-inline">
                                    <div class="form-check" style="padding-right:15px">
                                        <label class="form-check-label" for="chkBorrar">Borrar</label>
                                        <input type="checkbox" name="chkBorrar" id="chkBorrar" class="form-check-input" checked />
                                    </div>
                                    <div class="form-check">
                                        <label class="form-check-label" for="chkcargar">Cargar archivo</label>
                                        <input type="checkbox" name="chkcargar" id="chkcargar" class="form-check-input" />
                                    </div>
                                    <button type="button" id="btnExcel" class="btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" data-toggle="modal" data-target="#modalExcel" data-placement="top" title="Carga de Capacity" style="display:none">
                                        <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-cloud-upload" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                            <path fill-rule="evenodd" d="M4.406 1.342A5.53 5.53 0 0 1 8 0c2.69 0 4.923 2 5.166 4.579C14.758 4.804 16 6.137 16 7.773 16 9.569 14.502 11 12.687 11H10a.5.5 0 0 1 0-1h2.688C13.979 10 15 8.988 15 7.773c0-1.216-1.02-2.228-2.313-2.228h-.5v-.5C12.188 2.825 10.328 1 8 1a4.53 4.53 0 0 0-2.941 1.1c-.757.652-1.153 1.438-1.153 2.055v.448l-.445.049C2.064 4.805 1 5.952 1 7.318 1 8.785 2.23 10 3.781 10H6a.5.5 0 0 1 0 1H3.781C1.708 11 0 9.366 0 7.318c0-1.763 1.266-3.223 2.942-3.593.143-.863.698-1.723 1.464-2.383z" />
                                            <path fill-rule="evenodd" d="M7.646 4.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 5.707V14.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708l3-3z" />
                                        </svg> Carga de Capacity
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <button id="btnBorrar" type="submit" class="btn btn-danger">Procesar</button>
                            </div>
                        </div>
                    </form>
                    </div>

                <div class="card-body">
                    @*<table id="dtCAPACITY" class="display compact cell-border" width="100%"></table>*@
                    <div class="row">
                        <div class="col-md-12">
                            <div id="tblResp"></div>
                        </div>
                        <div class="col-md-12">
                            <div id="Report" style="display:none">
                                <a href='@Url.Action("DescargarExcel",new {})' class="btn btn-success btn-lg" title="Descargar Reporte">
                                    Descargar Reporte
                                    <svg width="1em" height="1em" viewBox="0 0 16 16" class="bi bi-box-arrow-in-down" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" d="M3.5 6a.5.5 0 0 0-.5.5v8a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-8a.5.5 0 0 0-.5-.5h-2a.5.5 0 0 1 0-1h2A1.5 1.5 0 0 1 14 6.5v8a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 14.5v-8A1.5 1.5 0 0 1 3.5 5h2a.5.5 0 0 1 0 1h-2z" />
                                        <path fill-rule="evenodd" d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div class="tab-pane" id="CONFIGCAPACITY">
            <div class="card" id="card_venta" style="width:100%">
                <div class="card-header">
                    <h5>
                        Tipos de Capacity
                    </h5>
                    <div class="col-auto" style="display: none" id="btnCleanInputs">
                        <button title="Nuevo Tipo de Pedido" class="btn btn-sm pd-x-15 btn-success btn-lg" onclick="cleanInputs()">
                            <i class="fa fa-plus-circle" aria-hidden="true"></i>
                        </button>
                    </div>
                    <br />
                    <form id="frm">
                        <div class="row">
                            <div class="col-md-2 pb-1">
                                <label for="idInput" class="visually-hidden">Id</label>
                                <input readonly type="number" value="0" class="form-control" name="idInput" id="idInput" placeholder="0">
                            </div>
                            <div class="col-md-6 pb-1">
                                <label for="nombreInput" class="visually-hidden">Nombre del Capacity</label>
                                <input type="text" class="form-control" name="nombreInput" id="nombreInput" placeholder="Nombre del tipo de Capacity" pattern="[A-Za-z0-9 áéíóúÁÉÍÓÚ]+" maxlength="45">
                            </div>
                            <div class="col-md-2" style="margin-top: 2.5%">
                                <div class="form-inline">
                                    <div class="form-check" style="padding-right:15px">
                                        <input type="checkbox" name="checkinv" id="checkinv" class="form-check-input" checked />
                                        <label class="form-check-label" for="chkNadro">Invenadro</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2" style="margin-top: 2.5%">
                                <div class="custom-control custom-checkbox form-group">
                                    <button id="btnContinuar" type="submit" class="btn btn-success mb-3">Continuar</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="card-body">
                    <div class="col-sm-12" style="margin-top: 1%">
                        <div class="row">
                            <div class="table-responsive">
                                <table class="table table-striped" id="DTPedEsp">
                                    <thead class="thead-primary">
                                        <tr>
                                            <th style="width:10%">#Id</th>
                                            <th style="width:30%">Tipo de Capacity</th>
                                            <th style="width:10%">Check Invenadro</th>
                                            <th style="width:10%"></th>

                                            <!--<th style="width:10%">Editar</th>-->
                                        </tr>
                                    </thead>
                                    @foreach (var item in lstMarca.catCapacity)
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>@item.TipoCapacity</td>
                                            <td>@item.Invenadro</td>
                                            <td>
                                                <button onclick="deleteCapacity(@item.Id)" class="btn btn-sm pd-x-15 btn-primary btn-uppercase mg-l-5" title="Borrar Proveedor">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4L4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" />
                                                    </svg>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </table>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
</div>
<div class="modal fade" id="modalExcel" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <form id="frmExcel" enctype="multipart/form-data" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalExcel-label">CARGAR UN EXCEL</h5>
                </div>
                <div class="modal-body">
                    <div class="custom-file">
                        <input type="file" class="custom-file-input" id="fileExcel" name="fileExcel" multiple data-show-upload="false">
                        <label id="lblFileName" class="custom-file-label" for="customFile">Seleccionar archivo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" id="btnCancelar" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="EnviarExcel">Iniciar Carga</button>
                </div>
            </div>
        </form>
    </div>
</div>
@section scripts{
    <script>

        function llenaDtable(dataSet) {
            var tblpedidosCargados = $('#tblExistencias').DataTable({
                data: dataSet,
                "destroy": true,
                "processing": true,
                columns: [
                    { data: "SKUAceptados", title: "SKU Aceptados" },
                    { data: "SKURechazados", title: "SKU Rechazados" },
                    { data: "Marca", title: "Marca " },
                ],
                "language": {
                    "zeroRecords": "Ningun dato disponible en esta tabla",
                    "info": "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                    "infoEmpty": "No hay registros disponibles",
                    "infoFiltered": "(Filtro de _MAX_  registros)",
                    "sSearch": "Buscar",
                    "paginate": {
                        "previous": "Anterior",
                        "next": "Siguiente",
                    },
                },
//                select: true,
                //buttons: false
            });
        }

        $(document).ready(function () {

            $('#Marca').multiselect({
                nonSelectedText: 'Seleccione un grupo',
                enableFiltering: true,
                includeSelectAllOption: true,
                maxHeight: 400,
                buttonWidth: '150px',
                buttonTextAlignment: 'left',
                selectAllText: "Marcar Todos",
                allSelectedText: "Todos Seleccionados",
                nSelectedText: "Grupos Seleccionados"
            });

            $('#chkBorrar').on("click", function () {
                if ($(this).is(":checked")) {
                    $('#chkcargar').prop("checked", false);
                    $("#btnExcel").css("display", "none");
                    $("#Combo").css("display", "block");
                    $("#btnBorrar").css("display", "block");
                }
                $('#chkBorrar').prop("checked", true);
            });

            $('#chkcargar').on("click", function () {
                if ($(this).is(":checked")) {
                    $("#btnExcel").css("display", "block");
                    $("#Combo").css("display", "none");
                    $('#chkBorrar').prop("checked", false);
                    $("#btnBorrar").css("display", "none");
                } else {
                    $("# btnExcel").css("display", "none");
                    $("#Combo").css("display", "block");
                    $('#chkBorrar').prop("checked", true);
                    $('#chkcargar').prop("checked", false);
                    $("#btnBorrar").css("display", "block");
                }
            });

            $("#btnCancelar").click(function () {
                $("#frmExcel").trigger("reset");
                $lblFileName.text("Seleccionar archivo");
            });

            var $lblFileName = $('#lblFileName');
            $('#fileExcel').change(function (e) {
                $lblFileName.text((e.target.files.length > 0) ? e.target.files[0].name : 'Seleccionar archivo');
            });
            ////$('#Marca').change(function () {
            ////    var flags = 2;
            ////    var formulario = document.getElementById('FrmCapacity');
            ////    $('#Suc option').remove();
            ////    Sucursal(flags,formulario);
            ////});

        /*el flag para este paso es 4*/
            $("#FrmCapacity").on("submit", function (event) {
                if ($('#chkBorrar').is(":checked")) {
                    var SelectMarca = $("#Marca").val();
                    if (SelectMarca == "" || SelectMarca == null) {
                        swal("¡Selecciona Una Marca/Sucursal", '', "error");
                        return false;
                    } else {
                        var formulario = document.getElementById('FrmCapacity');
                        var formData = new FormData(formulario);
                        var flag = 3;
                        formData.append("Flags", flag);
                        ////////////////////////////////////////
                        if (confirm("Vas a eliminar información, ¿Seguro de continuar?")) {
                            showLoading();
                            $.ajax({
                                type: "POST",
                                url: '@Url.Action("DelCapacity", "ConfGeneralesAbasto")',
                                processData: false,
                                contentType: false,
                                data: formData,
                                success: function (response) {
                                    hideLoading();
                                    if (response.Resp.Success) {
                                        swal(response.Resp.Message, '', "success").then((value) => {
                                            
                                        });
                                    } else {
                                        swal(response.Resp.Message, '', "error");
                                    }
                                },
                                error: function (e) {
                                    hideLoading();
                                    swal("¡Error inesperado al Eliminar!", '', "error");
                                }
                            });
                        }
                        ///////////////////////////////////////

                    }

                }else {
                    swal("¡Np puedes borrar, el check no esta marcado", '', "error");
                    return false;
                }

            });

        /*el flag para este paso es 3*/
            $("#frmExcel").on("submit", function (event) {
                if ($('#chkcargar').is(":checked")) {
                    var archivo = $("#fileExcel").val();
                    if (archivo != "") {
                        //////////
                        showLoading();
                        var formulario = document.getElementById('frmExcel');
                        var formData = new FormData(formulario);

                        var flag = 2;
                        formData.append("Flags", flag);
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("ResponseCapacity", "ConfGeneralesAbasto")',
                            processData: false,
                            contentType: false,
                            data: formData,
                            success: function (response) {
                                hideLoading();
                                if (response.respuesta.Success) {
                                    $("#modalExcel").modal('hide');
                                    $("#tblResp").html('<table id="tblExistencias" class="display expand" width="100%"></table>');
                                    if (response.tblValida.length > 0)
                                        $('#Report').show();
                                    llenaDtable(response.tblValida);
                                    swal('', response.respuesta.Message, "success").then((value) => {
                                    });
                                } else {
                                    swal('', response.respuesta.Message, "error").then((value) => {
                                        $("#modalExcel").modal('hide');
                                    });
                                }
                            },
                            error: function (e) {
                                hideLoading();
                                swal('', "¡Error inesperado en la carga!", "error").then((value) => {
                                    $("#modalExcel").modal('hide');
                                });
                                
                            }

                        });
                        /////////
                    } else {
                        swal("¡No se ha seleccionado un archivo!", '', "error");
                    }

                    $lblFileName.text("Seleccionar archivo");
                    return false;

                } else {
                    swal("aun no seleccionas el check de carga", '', "error");
                    return false;
                }

            });

        });

        $("#frm").submit(function (e) {
                e.preventDefault();

            var formulario = document.getElementById('frm');
            var formData = new FormData(formulario);

                if ($("#nombreInput").val() != "" ) {

                if (confirm("Vas guardar información, ¿Seguro de continuar?")) {

                    showLoading();
                        $.ajax({
                            url: "/ConfGeneralesAbasto/CatCapacity",
                            type: 'POST',
                            cache: false,
                            contentType: false,
                            processData: false,
                            data: formData,
                            success: function (response) {
                                hideLoading();

                                if (response.Resp.Success) {
                                    swal(response.Resp.Message, '', "success").then((value) => {
                                        location.reload();

                                    });
                                } else {
                                    swal(response.Resp.Message, '', "error");
                                }
                            },
                            error: function (e) {
                                hideLoading();
                                swal("hubo un problema del lado del servidor", '', "error");
                            }
                        });

                    }
                    @*{
                    document.location.href = "@Url.Content("~/ConfGeneralesAbasto/PedidosCompEspeciales")";
                }*@
                } else {
                    swal("El campo Nombre es obligatorio", '', "error");
                }


        });

        function deleteCapacity(Id) {

            if (confirm("Se eliminará el Capacity, desea continuar?")) {
                showLoading();
                $.ajax({
                    type: "POST",
                    url: "/ConfGeneralesAbasto/DelCatCapacity",
                    data: '{id:' + Id + '}',
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (response) {
                        hideLoading();
                        if (response.Resp.Success) {
                            swal(response.Resp.Message, '', "success").then((value) => {
                                location.reload();

                            });
                        } else {
                            swal(response.Resp.Message, '', "error");
                        }
                    },
                    error: function (e) {
                        hideLoading();
                        swal("¡Error inesperado al Eliminar!", '', "error");
                    }
                });

            }
        }

        $("#DTPedEsp tbody").on('click', 'tr', function () {

            $("#btnCleanInputs").show();

            var rowData = $(this).children("td").map(function () {
                return $(this).text();
            }).get();

            console.log(rowData)

            $("#idInput").val(rowData[0]);
            $("#nombreInput").val(rowData[1]);

            if (rowData[2] == "SI") {
                $("#checkinv").prop('checked', true)
            } else {
                $("#checkinv").prop('checked', false)
            }
        });

        function cleanInputs() {

            $("#btnCleanInputs").hide();
            $("#idInput").val('0');
            $("#nombreInput").val('');
            $("#cbSuma").prop('checked', false);
            $("#cbCompara").prop('checked', false);
            $("#cbPie").prop('checked', false);

        }
    </script>
}


                            <br />
                            @Html.RadioButtonFor(model => model.Resto_Productos, "2", new { id = "resto2", data_val = "true" })
                            <label for="Option2">Comprar al Mayor</label>
                            <br />
                            @Html.RadioButtonFor(model => model.Resto_Productos, "3", new { id = "resto3", data_val = "true" })
                            <label for="Option3">No Incluir</label>
                        </div>
                        @Html.ValidationMessage("Resto_Productos", new { @class = "text-danger" })

                    </div>
                </div>
            </div>


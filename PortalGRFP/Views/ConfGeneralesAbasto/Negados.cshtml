                                @Html.ValidationMessage("Rank_montos", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-4 pb-1">
                                @Html.LabelFor(d => d.Rank_piezas, new { @for = "Rank_piezas" })
                                @Html.TextBoxFor(d => d.Rank_piezas, new { required = true, @class = "form-control", @placeholder = "Ranking piezas", @type = "number", @min = 0, @id = "Rank_piezas", @style = "display:none", oninput = "validity.valid||(value='')" })
                                @Html.ValidationMessage("Rank_piezas", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <br />
            <div style="text-align: right" class="col-sm-6 pb-3">
                <input type="submit" class="btn btn-success" value="Guardar" />
            </div>


         

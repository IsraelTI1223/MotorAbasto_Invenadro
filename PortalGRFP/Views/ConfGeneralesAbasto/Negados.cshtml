@model PortalGRFP.Entities.Common.NegadosViewModel



@{
    ViewBag.Title = "Configuración de Negados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
    <div class="col-md-12 offset-md-1">
        <span class="anchor" id="formComplex"></span>
        @section Breadcrumbs{
            <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Home</a></li>
            <li class="breadcrumb-item"><a>Configuraciones</a></li>
            <li class="breadcrumb-item"><a>Generales de Abasto</a></li>
            <li class="breadcrumb-item"><a>Negados</a></li>

        }

        <!-- form complex example -->

        @using (Html.BeginForm("GuardarNegados", "ConfGeneralesAbasto", FormMethod.Post, new { role = "form", @class = "form-row mt-4", id = "frmNegados" }))
        {
            @Html.TextBoxFor(d => d.IdNegado, new { style = "display: none;" })
            <div class="col-sm-3 pb-3">
                @Html.LabelFor(d => d.PiezasXArticulo, new { @for = "PiezasXArticulo" })
                @Html.TextBoxFor(d => d.PiezasXArticulo, new { required = true, @class = "form-control", @placeholder = "Piezas Por Articulo", @type = "number", @id = "PiezasXArticulo", min = 0, oninput = "validity.valid||(value='')" })
                @Html.ValidationMessage("PiezasXArticulo", new { @class = "text-danger" })
            </div>

            <div class="col-sm-3 pb-3">
                @Html.LabelFor(d => d.Costo_Articulo, new { @for = "Costo_Articulo" })
                <div class="input-group">
                    <div class="input-group-prepend"><span class="input-group-text">$</span></div>
                    @Html.TextBoxFor(d => d.Costo_Articulo, new { required = true, @class = "form-control", @placeholder = "Costo Artículo", @type = "number", @id = "Costo_Articulo", min = 0, step = "0.0001", oninput = "validity.valid||(value='')" })
                    @Html.ValidationMessage("Costo_Articulo", new { @class = "text-danger" })
                </div>
            </div>

            <div class="col-sm-3 pb-3">
                @Html.LabelFor(d => d.PiezasXFarmacia, new { @for = "PiezasXFarmacia" })
                @Html.TextBoxFor(d => d.PiezasXFarmacia, new { required = true, @class = "form-control", @placeholder = "Piezas por Farmacia", @type = "number", @id = "PiezasXFarmacia", min = 0, oninput = "validity.valid||(value='')" })
                @Html.ValidationMessage("PiezasXFarmacia", new { @class = "text-danger" })
            </div>

            <div class="col-sm-3 pb-3">
                @Html.LabelFor(d => d.Imp_Negados_XDia, new { @for = "Imp_Negados_XDia" })
                <div class="input-group">
                    <div class="input-group-prepend"><span class="input-group-text">$</span></div>
                    @Html.TextBoxFor(d => d.Imp_Negados_XDia, new { required = true, @class = "form-control", @placeholder = "Importe de Negados", @type = "number", @id = "Imp_Negados_XDia", min = 0, step = "0.0001", oninput = "validity.valid||(value='')" })
                    @Html.ValidationMessage("Imp_Negados_XDia", new { @class = "text-danger" })
                </div>
            </div>
            <br />
            <div class="col-sm-3 pb-3">
                <label for="groupBtn"><strong>Invenadro:</strong></label>
                <div class="card" id="groupBtn" style="height:7.3rem">
                    <div class="card-body">
                        <div class="form-check">
                            @Html.RadioButtonFor(model => model.Invenadro, "1", new { id = "invenadro1", data_val = "true" })
                            <label for="Option1">Sumar al Sugerido</label>
                            <br />
                            @Html.RadioButtonFor(model => model.Invenadro, "2", new { id = "invenadro2", data_val = "true" })
                            <label for="Option2">Comprar al Mayor</label>
                            <br />
                            @Html.RadioButtonFor(model => model.Invenadro, "3", new { id = "invenadro3", data_val = "true" })
                            <label for="Option3">No Incluir</label>
                        </div>
                        @Html.ValidationMessage("Invenadro", new { @class = "text-danger" })

                    </div>
                </div>
            </div>

            <div class="col-sm-3 pb-3">
                <label for="groupBtn"><strong>Resto de Productos:</strong></label>

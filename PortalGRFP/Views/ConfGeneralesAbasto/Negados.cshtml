@section scripts{
    <script>

        function comprobar(obj) {
            if (obj.checked) {

                document.getElementById('Rank_montos').style.display = "";
                document.getElementById('Rank_piezas').style.display = "";
            } else {

                document.getElementById('Rank_montos').style.display = "none";
                document.getElementById('Rank_piezas').style.display = "none";
            }     
            
        }

        $("#frmNegados").on("submit", function (event) {
            event.preventDefault();

            swal({
                title: '',
                text: "¿Desea guardar los cambios?",
                icon: "warning",
                buttons: {
                    cancel: "Cancelar",
                    catch: {
                        text: "Guardar",
                        value: true
                    }
                },
            }).then((resp) => {                
                if (resp) {

                    var sucProv = $("#frmNegados").serializeArray()
                                .filter(function (elem) {
                                    return $.trim(elem.value);
                                });

                    //sucProv.forEach(function (valor, indice, array) {

                    if ($("#chkRanking").is(":checked") === true) {                     
                            sucProv.push({ name: "chkRanking2", value: true });
                        } else {
                            sucProv.push({ name: "chkRanking2", value: false });
                        }                 
                        console.log(sucProv);

                    //            if (valor.name == "PiezasXArticulo")
                    //            {
                    //                if (!Number.isInteger(parseInt(valor.value))) {
                    //                    alert("Solo se Aceptan números enteros para: " + valor.name);
                    //                    return;
                    //                }
                
                    //            }
                    //        });
                    console.log(sucProv);
                
                            showLoading();
                            $.ajax({
                                type: $("#frmNegados").attr('method'),
                                url: $("#frmNegados").attr('action'),
                                data: sucProv,
                                success: function (response) {
                                    hideLoading();
                                    if (response != undefined) {

                                        swal("¡Cambios Guardados!", '', "success").then((value) => {
                                            //window.location.reload();
                                        });
                                    } else {
                                        swal(response, '', "error").then((value) => {
                
                                        });
                                    }
                                },
                                error: function (response) {
                                    swal("Ocurrio un error de comunicación", '', "warning");
                                    hideLoading();
                                }
                            });
            }

            });
        });

        $(document).ready(function () {
            $("#chkRanking").change();
        });
    </script>
}




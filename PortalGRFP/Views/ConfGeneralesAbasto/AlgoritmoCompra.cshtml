@section scripts{
    <script>
        $("#frmAlgoritmo").on("submit", function (event) {
            event.preventDefault();
            var sum = parseInt($("#PonderacionSemana1").val()) + parseInt($("#PonderacionSemana2").val()) + parseInt($("#PonderacionSemana3").val()) + parseInt($("#PonderacionSemana4").val());
            if (sum == 100) {

                swal({
                    title: '',
                    text: "¿Desea guardar los cambios?",
                    icon: "warning",
                    buttons: {
                        cancel: "Cancelar",
                        catch: {
                            text: "Guardar",
                            value: true
                        }
                    },
                }).then((resp) => {

                    if (resp) {

                        var sucProv = $("#frmAlgoritmo").serializeArray()
                            .filter(function (elem) {

                                return $.trim(elem.value);
                            });



                        showLoading();
                        $.ajax({
                            type: $("#frmAlgoritmo").attr('method'),
                            url: $("#frmAlgoritmo").attr('action'),
                            data: sucProv,
                            success: function (response) {
                                hideLoading();
                                if (response != undefined) {

                                    swal("¡Cambios Guardados!", '', "success").then((value) => {
                                        // window.location.reload();
                                    });
                                } else {
                                    swal(response, '', "error").then((value) => {

                                    });
                                }
                            },
                            error: function (response) {
                                swal("Ocurrio un error de comunicación", '', "warning");
                                hideLoading();
                            }
                        });
                    }

                });
            } else {
                if (sum > 100) {
                    swal("Error", 'La ponderación no debe ser mayor a 100', "error")
                } else {
                    swal("Error", 'La ponderación no debe ser menor a 100', "error")
                }
            }
  
        });

        function filterFloat(evt, input) {
            // Backspace = 8, Enter = 13, ‘0′ = 48, ‘9′ = 57, ‘.’ = 46, ‘-’ = 43
            var key = window.Event ? evt.which : evt.keyCode;
            var chark = String.fromCharCode(key);
            var tempValue = input.value + chark;
            if (key >= 48 && key <= 57) {
                if (filter(tempValue) === false) {
                    return false;
                } else {
                    return true;
                }
            } else {
                if (key == 8 || key == 13 || key == 0) {
                    return true;
                } else if (key == 46) {
                    if (filter(tempValue) === false) {
                        return false;
                    } else {
                        return true;
                    }
                } else {
                    return false;
                }
            }
        }
        function filter(__val__) {
            var preg = /^([0-9]+\.?[0-9]{0,2})$/;
            if (preg.test(__val__) === true) {
                return true;
            } else {
                return false;
            }

        }

        function validateFloatKeyPress(el, evt) {

            var charCode = (evt.which) ? evt.which : event.keyCode;
            var number = el.value.split(',');
            // permitir el signo de - (45)
            if (charCode != 45 && charCode != 44 && charCode > 31 && (charCode < 48 || charCode > 57)) {
                return false;
            }
            //just one dot
            if (number.length > 1 && charCode == 44) {
                return false;
            }
            //get the carat position
            var caratPos = getSelectionStart(el);
            // no permitir que se ponega el - en una posicion diferente de la inicial
            if (caratPos > 0 && charCode == 45) {
                return false;
            }
            // no permtir mas de un - en el numero
            if (charCode == 45 && el.value.charAt(0) == "-") {
                return false;
            }
            var dotPos = el.value.indexOf(",");
            if (caratPos > dotPos && dotPos > -1 && (number[1].length > 1)) {
                return false;
            }
            return true;
        }

        function getSelectionStart(o) {
            if (o.createTextRange) {
                var r = document.selection.createRange().duplicate()
                r.moveEnd('character', o.value.length)
                if (r.text == '') return o.value.length
                return o.value.lastIndexOf(r.text)
            } else { return o.selectionStart }
        }
    </script>
}



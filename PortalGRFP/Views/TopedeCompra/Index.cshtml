@using PortalGRFP.Entities.Common


@{
    ViewBag.Title = "Tope de Compra";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<span class="anchor" id="formComplex"></span>
@section Breadcrumbs{
    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Home</a></li>
    <li class="breadcrumb-item"><a>Configuración</a></li>
    <li class="breadcrumb-item"><a>Tope de Compra</a></li>
}

<div class="col-sm-12">
    <div class="card mb-12">
        <form id="frm">
            <div class="row g-0">
                <div class="card-body">
                    <div class="row" style="margin-left:5px">
                        <div class="col-md-6" style="margin-top:7px">
                            <br />
                            <div class="custom-file">
                                <input type="file" class="custom-file-input" id="fileExcel" name="fileExcel" multiple data-show-upload="false">
                                <label id="lblFileName" class="custom-file-label" for="customFile">Seleccionar archivo</label>
                            </div>
                        </div>
                        <div class="col-md-2">

                        </div>
                        <div class="col-md-2">
                            <br />
                            <div class="btn-group">
                                <div style="text-align: right; margin-left: 149%; margin-top: 7px" >
                                    <button id="btnCargar" type="button" class="btn btn-primary mb-3"> Cargar</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <br />
                            <div class="btn-group">
                                <div style="text-align: right; margin-left: 50%; margin-top: 7px">
                                    <button id="btnDescarga" type="button" class="btn btn-warning mb-3"> Descargar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <br />
    <div class="card mb-12">
        <h4 hidden="hidden" id="title">Registros Rechazados</h4>
        <table id="tbConsulta" name="tbConsulta" class="table-striped" width="100%"> </table>
    </div>
</div>


@section scripts{
    <script>
        $(document).ready(function () {

            $("#btnCargar").click(function () {

                CargaExcep();

            });

            var $lblFileName = $('#lblFileName');

            $('#fileExcel').change(function (e) {
                $lblFileName.text((e.target.files.length > 0) ? e.target.files[0].name : 'Seleccionar archivo');
            });

            function CargaExcep() {

                var archivo = $("#fileExcel").val();
                if (archivo != "") {

                    var formulario = document.getElementById('frm');
                    var formData = new FormData(formulario);

                      showLoading();
                      $.ajax({
                        type: "POST",
                        url: "@Url.Action("CargaTopedeCompra", "TopedeCompra")",
                        processData: false,
                        contentType: false,
                          data: formData,
                          success: function (response) {
                              if (response.Success) {

                                  swal(response.Message, '', "success").then((value) => {
                                      Reset();
                                      Consulta();
                                  });
                              } else {
                                  swal(response.Message, '', "error");
                              }
                              hideLoading();
                      },
                          error: function (response) {
                              hideLoading();
                              swal(response.Message, '', "warning");
                          }
                      });
                } else {
                    swal("¡No se ha seleccionado un archivo!", '', "error");
                }
            }

            function Consulta() {

                   $.ajax({
                    url: "@Url.Action("ConsultaTope", "TopedeCompra")",
                    type: "POST",
                    data: "",
                    dataType: "json",
                       success: function (response) {
                           hideLoading();
                           console.log(response)

                           document.getElementById("title").hidden = false;

                           dtapi = null;
                           dtapi = $('#tbConsulta').DataTable({
                                   data: response.Result,
                                   "destroy": true,
                                   "processing": true,
                                   dom: 'Bfrtip',
                               columns: [
                                   { data: "IdSucursal", title: 'Id Sucursal'},
                                   { data: "Sucursal", title: 'Sucursal' },
                                   { data: "SKU", title: "SKU" },
                                   { data: "DescripcionSKU", title: "Descripcion" },
                                   { data: "Limite", title: "Limite" },
                                   { data: "Concepto", title: "Concepto" },
                                   { data: "Motivo", title: "Motivo Rechazo" },
                                   { data: "Usuario", title: "Usuario Realizó" },
                               ],
                               select: true,
                               scrollCollapse: true,
                               info: true,
                               paging: true,
                               responsive: true,
                               searching: true
                           });

                       },
                       error: function (response) {
                            swal(response.Message, '', "error");
                       }
                   });
            }

            function Reset() {

                $('#lblFileName').empty();

            }

            $("#btnDescarga").click(function () {

                $.ajax({
                    type: "POST",
                    url: "/TopedeCompra/DescargarExcel",
                    data: "",
                    processData: false,
                    contentType: false,
                    xhrFields: {
                        responseType: 'blob'
                    },
                    success: function (data) {
                        hideLoading();

                        window.location = '/TopedeCompra/Descargar';
                    },
                    error: function (data) {
                        hideLoading();
                        //swal('Error', 'Error Inesperado' + data, "error");
                    }
                });

            });



        });

    </script>
}


